rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins carry the `admin: true` custom claim on their ID token, set only with the
    // Admin SDK (scripts/setAdminClaim.mjs). It is not stored in users/{uid}, so no client
    // write can grant it.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPassenger() {
      return isSignedIn() && userDoc().data.role == 'passenger';
    }

    function driverPath(uid) {
      return /databases/$(database)/documents/drivers/$(uid);
    }

    function bookingPath(id) {
      return /databases/$(database)/documents/bookings/$(id);
    }

    function requestPath(id) {
      return /databases/$(database)/documents/outOfAreaRequests/$(id);
    }

    function applicationPath(uid) {
      return /databases/$(database)/documents/driverApplications/$(uid);
    }

    function applicationDocumentPath(uid, docType) {
      return /databases/$(database)/documents/driverApplications/$(uid)/documents/$(docType);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function contactPath(uid) {
      return /databases/$(database)/documents/contacts/$(uid);
    }

    function deletionRequestPath(uid) {
      return /databases/$(database)/documents/deletionRequests/$(uid);
    }

    function legalConsentPath(uid, version) {
      return /databases/$(database)/documents/users/$(uid)/legalConsents/$(version);
    }

    // ─── Privacy: legal version and account deletion ───────────────────────
    // The version of the Privacy Notice and Terms of Use that users accept. Keep equal to
    // LEGAL_VERSION in shared/legal/meta.ts (tests/legal/legalRulesSync.test.ts).
    function currentLegalVersion() {
      return '1.1';
    }

    // The document at `path` is anonymized (account deletion) in this very commit.
    function isAnonymizedInThisCommit(path) {
      return getAfter(path).data.get('anonymizedAt', null) == request.time;
    }

    function driverDoc() {
      return get(driverPath(request.auth.uid));
    }

    // Driver capability comes from an admin: either a `driver` account, or a passenger
    // whose driver application was approved AND who has an admin-created drivers/{uid}
    // record. Clients can never create drivers/{uid} or approve an application.
    function isDriver() {
      return isSignedIn()
        && (
          userDoc().data.role == 'driver'
          || (
            userDoc().data.role == 'passenger'
            && exists(driverPath(request.auth.uid))
            && exists(/databases/$(database)/documents/driverApplications/$(request.auth.uid))
            && get(/databases/$(database)/documents/driverApplications/$(request.auth.uid)).data.status == 'approved'
          )
        );
    }

    function isValidVehiclePlate(plate) {
      return plate is string && plate.matches('^[A-Z0-9][A-Z0-9 -]{0,10}[A-Z0-9]$');
    }

    // Brand (1–30) and model (1–40): letters, digits, spaces and . / + -, starting with a
    // letter or digit. Color (1–20): letters, spaces, / and -, starting and ending with a
    // letter. Passengers use them to spot their driver.
    function isValidVehicleDetails(data) {
      return data.vehicleBrand is string
        && data.vehicleBrand.matches('^[A-Za-z0-9]([A-Za-z0-9 ./+-]{0,28}[A-Za-z0-9.])?$')
        && data.vehicleModel is string
        && data.vehicleModel.matches('^[A-Za-z0-9]([A-Za-z0-9 ./+-]{0,38}[A-Za-z0-9.])?$')
        && data.vehicleColor is string
        && data.vehicleColor.matches('^[A-Za-z]([A-Za-z /-]{0,18}[A-Za-z])?$');
    }

    // Driver access needs both the `driver` role in users/{uid} and an admin-verified
    // record in drivers/{uid}. Only verified drivers may accept new bookings.
    function isVerifiedDriver() {
      return isDriver()
        && exists(driverPath(request.auth.uid))
        && driverDoc().data.isVerified == true;
    }

    // True when an update changes only the listed fields.
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function commissionSettingsPath() {
      return /databases/$(database)/documents/commissionSettings/active;
    }

    function commissionPath(bookingId) {
      return /databases/$(database)/documents/commissions/$(bookingId);
    }

    function commissionAccountPath(uid) {
      return /databases/$(database)/documents/commissionAccounts/$(uid);
    }

    function commissionPeriodPath(uid, seq) {
      return /databases/$(database)/documents/commissionPeriods/$(uid + '_' + string(seq));
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/commissionPayments/$(paymentId);
    }

    function paymentReferencePath(reference) {
      return /databases/$(database)/documents/paymentReferences/$(reference);
    }

    function ledgerPath() {
      return /databases/$(database)/documents/earningsLedger/totals;
    }

    function cashOutPath(cashOutId) {
      return /databases/$(database)/documents/cashOuts/$(cashOutId);
    }

    // An admin confirms this pending payment in the current commit.
    function isConfirmedInThisCommit(paymentId) {
      return paymentId is string
        && get(paymentPath(paymentId)).data.status == 'pending'
        && getAfter(paymentPath(paymentId)).data.status == 'confirmed';
    }

    // A commission period ends at a Manila midnight (UTC+8, no daylight saving): the end
    // of the `days`-th calendar day, counting the day of startAt as day 1. Epoch ms.
    // The app computes the same (src/utils/commission.ts); nothing stores the end itself,
    // so no client clock is ever trusted.
    function periodEndMillis(startAt, days) {
      return (math.floor((startAt.toMillis() + 28800000) / 86400000) + days) * 86400000 - 28800000;
    }

    // When the grace period after a commission period (account.current or account.unpaid)
    // ends. Epoch ms.
    function graceEndMillis(period) {
      return periodEndMillis(period.startAt, period.periodDays) + period.graceDays * 86400000;
    }

    // Commission enforcement: the signed-in driver still owes commission after a grace
    // period ended, either the oldest unpaid closed period's or the running period's once
    // it has ended (src/utils/commission.ts commissionStatus 'suspended'). It blocks only
    // new work: T1 accept and the out-of-area propose. A confirmed payment that covers the
    // overdue amount clears it (the unpaid pointer moves on), with no other write.
    function isCommissionSuspended() {
      let path = commissionAccountPath(request.auth.uid);
      return exists(path) && isSuspendedAccount(get(path).data);
    }

    // Admin suspension (Admin Website, Drivers): drivers/{uid}.suspendedAt is set, the
    // suspension was not lifted, and suspendedUntil is null (until lifted) or still ahead.
    // Like the commission suspension it blocks only new work (T1 accept and the out-of-area
    // propose); it ends by itself at suspendedUntil. Same test as src/utils/adminSuspension.ts.
    function isAdminSuspended(driver) {
      return driver.get('suspendedAt', null) != null
        && driver.get('suspensionLiftedAt', null) == null
        && (driver.get('suspendedUntil', null) == null || request.time < driver.suspendedUntil);
    }

    function isSuspendedAccount(account) {
      return (account.unpaid != null && request.time.toMillis() >= graceEndMillis(account.unpaid))
        || (
          account.paidCentavos < account.accruedCentavos
          && request.time.toMillis() >= graceEndMillis(account.current)
        );
    }

    // ─── Daily acceptance quota ────────────────────────────────────────────
    // Each driver may accept at most dailyLimit passengers per Manila day (resets at
    // 12:00 AM Manila). The admin sets one limit for every driver (quotaSettings/active);
    // each driver has their own count on drivers/{uid}: acceptedCount trips on acceptedDay.

    // Used while quotaSettings/active does not exist. Keep in sync with
    // DEFAULT_DAILY_LIMIT in src/utils/dailyQuota.ts (tests/booking/dailyQuotaSync.test.ts).
    function defaultDailyLimit() {
      return 20;
    }

    function dailyLimit() {
      let path = /databases/$(database)/documents/quotaSettings/active;
      return exists(path) ? get(path).data.dailyLimit : defaultDailyLimit();
    }

    // Days since 1 Jan 1970 in Manila time (UTC+8, no daylight saving), as
    // src/utils/dailyQuota.ts manilaDay computes it.
    function manilaDayOf(time) {
      return math.floor((time.toMillis() + 28800000) / 86400000);
    }

    // At most 2 decimal places (centavos). Compared with a tolerance because e.g.
    // 8.15 * 100 is not exactly 815 in floating point.
    function hasAtMostTwoDecimals(value) {
      return math.abs(value * 100 - math.round(value * 100)) < 0.000001;
    }

    // ─── Trip limits (security batch A, 2026-11-19) ───────────────────────────
    // Keep equal to shared/bookings/limits.ts (tests/booking/bookingLimitsSync.test.ts).
    function maxFarePesos() {
      return 20000;
    }

    function maxDistanceKm() {
      return 300;
    }

    function maxAddressLength() {
      return 200;
    }

    // A fare: more than 0, at most maxFarePesos(), whole centavos. NaN fails every
    // comparison and Infinity fails the maximum, so only finite amounts pass.
    function isValidFareAmount(value) {
      return value is number
        && value > 0
        && value <= maxFarePesos()
        && hasAtMostTwoDecimals(value);
    }

    // Exactly latitude, longitude and an address of at most maxAddressLength() characters.
    function isValidLocation(loc) {
      return loc is map
        && loc.keys().hasAll(['latitude', 'longitude', 'address'])
        && loc.keys().hasOnly(['latitude', 'longitude', 'address'])
        && loc.latitude is number
        && loc.longitude is number
        && loc.address is string
        && loc.address.size() <= maxAddressLength();
    }

    // Generous box around Bohol (standard bookings) and around the Philippines (out-of-area
    // requests). Comparisons also reject NaN and Infinity.
    function isInBohol(loc) {
      return loc.latitude >= 9.4 && loc.latitude <= 10.25
        && loc.longitude >= 123.6 && loc.longitude <= 124.7;
    }

    function isInPhilippines(loc) {
      return loc.latitude >= 4.0 && loc.latitude <= 21.5
        && loc.longitude >= 116.0 && loc.longitude <= 127.0;
    }

    // Road distance (km, from the app's route) plausible for the two points: above 0, at most
    // maxDistanceKm(), between 0.9 × and 4 × + 2 km the straight line (equirectangular
    // approximation at ~10° N: 109.6 km per degree of longitude, 110.6 km per degree of
    // latitude).
    function isPlausibleDistance(distanceKm, a, b) {
      let dx = (b.longitude - a.longitude) * 109.6;
      let dy = (b.latitude - a.latitude) * 110.6;
      let straight = math.sqrt(dx * dx + dy * dy);
      return distanceKm is number
        && distanceKm > 0
        && distanceKm <= maxDistanceKm()
        && distanceKm >= 0.9 * straight
        && distanceKm <= 4 * straight + 2;
    }

    // The admin per-km fares (fareSettings/active.fares), or the app's in-code defaults while
    // none are saved. Keep the defaults equal to DEFAULT_FARE_SETTINGS in src/constants
    // (tests/booking/bookingLimitsSync.test.ts).
    function activeFares() {
      let path = /databases/$(database)/documents/fareSettings/active;
      let defaults = {
        'tricycle': { 'baseFare': 15, 'perKm': 8 },
        'motorcycle': { 'baseFare': 10, 'perKm': 6 }
      };
      return exists(path) ? get(path).data.get('fares', defaults) : defaults;
    }

    // fare == base + rate × distance, kept to the centavo exactly as shared/fares perKmFare
    // (Math.round of the amount × 100).
    function isPerKmFare(fare, rate, distanceKm) {
      return math.round(fare * 100) == math.round((rate.baseFare + rate.perKm * distanceKm) * 100);
    }

    // passengerOpenRequest/{uid}: the passenger's newest booking or out-of-area request.
    function openRequestPath(uid) {
      return /databases/$(database)/documents/passengerOpenRequest/$(uid);
    }

    // ─── Users ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Admins read any profile (user management on the admin website).
      allow read: if isOwner(userId) || isAdmin();

      // legalConsent {version, acceptedAt}: the current legal version, accepted now, with
      // its consent log entry users/{uid}/legalConsents/{version} created in the same commit
      // (one entry per version, so each version is accepted once).
      function isNewConsent(data) {
        return data.legalConsent is map
          && data.legalConsent.keys().hasOnly(['version', 'acceptedAt'])
          && data.legalConsent.version == currentLegalVersion()
          && data.legalConsent.acceptedAt == request.time
          && !exists(legalConsentPath(userId, currentLegalVersion()))
          && existsAfter(legalConsentPath(userId, currentLegalVersion()));
      }

      // Registration may record consent; an account without it accepts later (re-consent).
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'passenger'
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.mobileNumber is string
        && !('anonymizedAt' in request.resource.data)
        && (!('legalConsent' in request.resource.data) || isNewConsent(request.resource.data));

      // Passengers may update their own profile but cannot change role or uid, consent
      // (only through the rule below) or anything once the account is anonymized.
      allow update: if isOwner(userId)
        && isPassenger()
        && resource.data.get('anonymizedAt', null) == null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['legalConsent', 'anonymizedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.role == 'passenger';

      // Consent and re-consent, for any role (passenger or driver account): only
      // legalConsent and updatedAt change.
      allow update: if isOwner(userId)
        && resource.data.get('anonymizedAt', null) == null
        && onlyChanged(['legalConsent', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && isNewConsent(request.resource.data);

      // Account deletion (admin website): the profile is anonymized once, in one commit with
      // the rest of the account's personal data: contacts/{uid} deleted, drivers/{uid} and
      // driverApplications/{uid} anonymized when they exist, and a pending deletion request
      // completed. uid, role, dates and the consent record stay. The sign-in account is
      // deleted by hand in the Firebase Console (no Cloud Functions).
      allow update: if isAdmin()
        && request.resource.data.get('anonymizedAt', null) == request.time
        && resource.data.get('anonymizedAt', null) == null
        && onlyChanged(['fullName', 'email', 'mobileNumber', 'profileImage', 'anonymizedAt', 'updatedAt'])
        && request.resource.data.fullName == 'Deleted user'
        && request.resource.data.email == ''
        && request.resource.data.mobileNumber == ''
        && request.resource.data.get('profileImage', null) == null
        && request.resource.data.anonymizedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(contactPath(userId))
        && (!exists(driverPath(userId)) || isAnonymizedInThisCommit(driverPath(userId)))
        && (!exists(applicationPath(userId)) || isAnonymizedInThisCommit(applicationPath(userId)))
        && (
          !exists(deletionRequestPath(userId))
          || get(deletionRequestPath(userId)).data.status != 'pending'
          || getAfter(deletionRequestPath(userId)).data.status == 'completed'
        );
    }

    // ─── Consent log ───────────────────────────────────────────────────────
    // users/{uid}/legalConsents/{version} {version, acceptedAt}: one entry per accepted
    // version, written with users/{uid}.legalConsent in the same commit, never changed.

    match /users/{userId}/legalConsents/{version} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && version == currentLegalVersion()
        && request.resource.data.keys().hasOnly(['version', 'acceptedAt'])
        && request.resource.data.version == version
        && request.resource.data.acceptedAt == request.time
        && getAfter(userPath(userId)).data.legalConsent.version == version
        && getAfter(userPath(userId)).data.legalConsent.acceptedAt == request.time;

      allow update, delete: if false;
    }

    // ─── Account deletion requests ─────────────────────────────────────────
    // deletionRequests/{uid} {uid, status, requestedAt, reason?, completedAt?, completedBy?,
    // authDeletedAt?, authDeletedBy?, declineNote?, declinedAt?, declinedBy?}.
    // The user asks (pending) and may withdraw while pending. An admin either completes it,
    // only in the commit that anonymizes users/{uid}, or declines it with a note. A completed
    // request stays as the record; the admin later records that the sign-in account was
    // deleted by hand in the Firebase Console. A declined request may be removed by its owner,
    // who can then ask again.

    match /deletionRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'status', 'requestedAt', 'reason'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && (
          request.resource.data.get('reason', null) == null
          || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500)
        )
        && get(userPath(uid)).data.get('anonymizedAt', null) == null;

      allow delete: if isOwner(uid)
        && resource.data.status in ['pending', 'declined'];

      // Complete: with the anonymization, in one commit.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && onlyChanged(['status', 'completedAt', 'completedBy'])
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt == request.time
        && request.resource.data.completedBy == request.auth.uid
        && isAnonymizedInThisCommit(userPath(uid));

      // Decline (e.g. not the account holder, or a duplicate): a note the user can read.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && onlyChanged(['status', 'declineNote', 'declinedAt', 'declinedBy'])
        && request.resource.data.status == 'declined'
        && request.resource.data.declineNote is string
        && request.resource.data.declineNote.size() > 0
        && request.resource.data.declineNote.size() <= 500
        && request.resource.data.declinedAt == request.time
        && request.resource.data.declinedBy == request.auth.uid;

      // The sign-in account was deleted in the Firebase Console (no Cloud Functions): recorded
      // once, on a completed request.
      allow update: if isAdmin()
        && resource.data.status == 'completed'
        && !('authDeletedAt' in resource.data)
        && onlyChanged(['authDeletedAt', 'authDeletedBy'])
        && request.resource.data.authDeletedAt == request.time
        && request.resource.data.authDeletedBy == request.auth.uid;
    }

    // ─── Contacts ──────────────────────────────────────────────────────────
    // contacts/{uid}: the user's name and mobile number, kept equal to users/{uid} by its
    // owner. Readable by the other party of an active trip only: the driver assigned to the
    // passenger's booking, and that booking's passenger. "Assigned and active" comes from
    // drivers/{driverUid}.currentBookingId (set on accept/claim, cleared when the trip ends)
    // plus the booking's status, so a cancelled trip stops sharing at once.

    match /contacts/{uid} {
      function currentBookingOf(driverUid) {
        return get(bookingPath(get(driverPath(driverUid)).data.currentBookingId)).data;
      }

      function hasCurrentBooking(driverUid) {
        return exists(driverPath(driverUid))
          && get(driverPath(driverUid)).data.get('currentBookingId', null) is string;
      }

      function isActiveTripBetween(passengerUid, driverUid) {
        return hasCurrentBooking(driverUid)
          && currentBookingOf(driverUid).passengerId == passengerUid
          && currentBookingOf(driverUid).driverId == driverUid
          && currentBookingOf(driverUid).status in ['accepted', 'arrived', 'in_progress'];
      }

      allow read: if isOwner(uid);

      // The assigned driver reads their current passenger's card.
      allow read: if isDriver()
        && isActiveTripBetween(uid, request.auth.uid);

      // A passenger reads the card of the driver assigned to their active booking.
      allow read: if isSignedIn()
        && isActiveTripBetween(request.auth.uid, uid);

      // getAfter, so a profile edit can update users/{uid} and this card in one batch.
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['fullName', 'mobileNumber', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.mobileNumber is string
        && request.resource.data.fullName
          == getAfter(/databases/$(database)/documents/users/$(uid)).data.fullName
        && request.resource.data.mobileNumber
          == getAfter(/databases/$(database)/documents/users/$(uid)).data.mobileNumber
        && getAfter(userPath(uid)).data.get('anonymizedAt', null) == null
        && request.resource.data.updatedAt == request.time;

      // Account deletion: an admin deletes the card in the commit that anonymizes users/{uid}.
      allow delete: if isAdmin()
        && isAnonymizedInThisCommit(userPath(uid));
    }

    // Passenger late-driver cancel (bookings T5). Keep equal to PASSENGER_NO_SHOW_CANCEL_MINUTES
    // and DRIVER_NO_SHOW_REASON in src/constants/cancellation.ts
    // (tests/booking/passengerCancelSync.test.ts fails if they differ).
    function passengerNoShowCancelMinutes() {
      return 15;
    }

    function driverNoShowReason() {
      return 'Driver did not arrive';
    }

    // ─── Bookings ──────────────────────────────────────────────────────────
    // Ride lifecycle (docs/plans/task2-ride-lifecycle.md):
    //   pending → accepted → arrived → in_progress → completed, or → cancelled.
    // Only the assigned driver moves a ride forward, one step at a time. Completed and
    // cancelled bookings are final. After creation, driverId changes only on accept and
    // finalFare is written only on completion (equal to the agreed/estimated fare); no
    // other fare field can change. Fields older bookings may lack are read with
    // .get(field, default) in update rules. Read rules use plain field access so list
    // queries (open requests, trip history) can be checked against their filters.

    match /bookings/{bookingId} {
      function isValidCancelReason() {
        return request.resource.data.get('cancellationReason', null) == null
          || (
            request.resource.data.cancellationReason is string
            && request.resource.data.cancellationReason.size() <= 200
          );
      }

      // finalFare = agreedFare (out-of-area) when set, otherwise estimatedFare.
      function isExpectedFinalFare() {
        let agreedFare = resource.data.get('agreedFare', null);
        return request.resource.data.finalFare is number
          && (
            (agreedFare == null && request.resource.data.finalFare == resource.data.estimatedFare)
            || (agreedFare != null && request.resource.data.finalFare == agreedFare)
          );
      }

      function isAssignedDriver() {
        return isDriver() && resource.data.get('driverId', null) == request.auth.uid;
      }

      // Admins read every booking (Admin Website: passenger history, drivers, reports).
      // Read-only: no admin write rule exists for bookings.
      allow read: if isAdmin();

      allow read: if isSignedIn()
        && resource.data.passengerId == request.auth.uid;

      // Verified drivers see open standard bookings.
      // Out-of-area bookings are never open: their driver comes from the fare agreement.
      allow read: if isVerifiedDriver()
        && resource.data.status == 'pending'
        && resource.data.driverId == null
        && resource.data.bookingType == 'standard';

      // A driver can always read bookings assigned to them (active trip and trip history),
      // even if their verification is revoked later.
      allow read: if isDriver()
        && resource.data.driverId == request.auth.uid;

      // The driver agreed on an out-of-area request can read its booking (bookings/{requestId})
      // before claiming it, and see if the passenger cancelled it.
      allow read: if isVerifiedDriver()
        && resource.data.bookingType == 'out_of_area'
        && get(requestPath(bookingId)).data.driverId == request.auth.uid;

      // Out-of-area create (bookingService.acceptProposalAndCreateBooking): the passenger
      // creates bookings/{requestId} in the same commit that accepts the driver's fare on
      // their open, unexpired request. Trip details and fares are copied from the request
      // and the fare agreement equals the one stored on the accepted request. The booking
      // stays unassigned; the agreed driver (request.driverId) claims it separately.
      function isValidOutOfAreaBookingCreate() {
        let data = request.resource.data;
        let req = get(requestPath(bookingId)).data;
        let reqAfter = getAfter(requestPath(bookingId)).data;
        return data.keys().hasOnly([
            'passengerId', 'driverId', 'vehicleType', 'bookingType', 'pickupLocation',
            'destination', 'distanceKm', 'estimatedFare', 'driverProposedFare', 'agreedFare',
            'fareAgreement', 'finalFare', 'status', 'outOfAreaRequestId', 'createdAt',
            'updatedAt', 'acceptedAt', 'arrivedAt', 'startedAt', 'completedAt', 'cancelledAt',
            'paymentMethod', 'cancelledBy', 'cancellationReason'
          ])
          && data.passengerId == request.auth.uid
          && data.bookingType == 'out_of_area'
          && data.status == 'pending'
          && data.driverId == null
          && data.outOfAreaRequestId == bookingId
          && req.passengerId == request.auth.uid
          && req.status == 'negotiating'
          && req.driverId is string
          && req.expiresAt is timestamp
          && request.time < req.expiresAt
          && reqAfter.status == 'accepted'
          && data.vehicleType == req.vehicleType
          && data.pickupLocation == req.pickupLocation
          && data.destination == req.destination
          && data.distanceKm == req.distanceKm
          && data.estimatedFare == req.standardEstimatedFare
          && data.driverProposedFare == req.fareAgreement.driverProposedFare
          && data.agreedFare == req.fareAgreement.driverProposedFare
          && data.fareAgreement == reqAfter.fareAgreement
          && data.finalFare == null
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.get('acceptedAt', null) == null
          && data.get('arrivedAt', null) == null
          && data.get('startedAt', null) == null
          && data.get('completedAt', null) == null
          && data.get('cancelledAt', null) == null
          && data.get('paymentMethod', null) == null
          && data.get('cancelledBy', null) == null
          && data.get('cancellationReason', null) == null;
      }

      function isOptionalBarangayId(value) {
        return value == null || (value is string && value.size() > 0 && value.size() <= 40);
      }

      // A barangay tariff booking is Poblacion <-> X, X's tariff is active and estimatedFare
      // equals it for the vehicle type. A missing tariff document fails the get (denied).
      // (Tariffs are written by admins with whole centavos, above 0.)
      function isTariffFare(pickup, destination) {
        let barangayId = pickup == 'poblacion' ? destination : pickup;
        let tariff = get(/databases/$(database)/documents/barangayTariffs/$(barangayId)).data;
        return (pickup == 'poblacion') != (destination == 'poblacion')
          && barangayId is string
          && tariff.active == true
          && request.resource.data.estimatedFare == tariff[request.resource.data.vehicleType];
      }

      // Fare basis of a new standard booking (barangay tariffs, 2026-10-28): fareBasis
      // 'per_km' or 'barangay_tariff' (no perKmRate), with optional pickup/destination barangay
      // IDs. A missing fareBasis (older app versions) is per-km. Per-km (security batch A,
      // 2026-11-19): estimatedFare is recomputed from the admin fares for the vehicle and the
      // distance and must match to the centavo; a stored perKmRate must be that rate.
      // Known limit: rules cannot check that the pins are really in those barangays, and the
      // road distance comes from the app (bounded by isPlausibleDistance).
      function isValidFareBasis() {
        let data = request.resource.data;
        let basis = data.get('fareBasis', 'per_km');
        let pickup = data.get('pickupBarangayId', null);
        let destination = data.get('destinationBarangayId', null);
        let perKmRate = data.get('perKmRate', null);
        return isOptionalBarangayId(pickup)
          && isOptionalBarangayId(destination)
          && (
            (
              basis == 'per_km'
              && isPerKmBooking(data, perKmRate, activeFares()[data.vehicleType])
            )
            || (basis == 'barangay_tariff' && perKmRate == null && isTariffFare(pickup, destination))
          );
      }

      // Per-km: the stored rate (if any) is the admin rate and the fare matches it. Only
      // evaluated for per-km bookings, so tariff bookings never read the fare settings.
      function isPerKmBooking(data, perKmRate, rate) {
        return (perKmRate == null || perKmRate == rate.perKm)
          && isPerKmFare(data.estimatedFare, rate, data.distanceKm);
      }

      // Exactly the fields createStandardBooking writes (security batch A, SEC-02): trip,
      // fare basis and expiry, every later field still empty, server times.
      function isValidStandardBookingShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'passengerId', 'driverId', 'vehicleType', 'bookingType', 'pickupLocation',
            'destination', 'distanceKm', 'estimatedFare', 'driverProposedFare', 'agreedFare',
            'fareAgreement', 'finalFare', 'status', 'outOfAreaRequestId', 'createdAt',
            'updatedAt', 'acceptedAt', 'arrivedAt', 'startedAt', 'completedAt', 'cancelledAt',
            'paymentMethod', 'cancelledBy', 'cancellationReason', 'expiresAt', 'fareBasis',
            'pickupBarangayId', 'destinationBarangayId', 'perKmRate'
          ])
          && data.get('fareBasis', 'per_km') in ['per_km', 'barangay_tariff']
          && [
            data.get('driverProposedFare', null), data.get('agreedFare', null),
            data.get('fareAgreement', null), data.get('finalFare', null),
            data.get('outOfAreaRequestId', null), data.get('acceptedAt', null),
            data.get('arrivedAt', null), data.get('startedAt', null),
            data.get('completedAt', null), data.get('cancelledAt', null),
            data.get('paymentMethod', null), data.get('cancelledBy', null),
            data.get('cancellationReason', null)
          ] == [null, null, null, null, null, null, null, null, null, null, null, null, null]
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      // Passengers create standard bookings with driverId == null. Driver assignment is a
      // separate, authorized operation (driver app) and must never be set by the passenger.
      // Standard bookings expire (2026-11-01): the app writes expiresAt from the admin
      // setting (fareSettings/active.booking, 1-30 min); the 35-minute cap leaves 5 minutes
      // of client clock-skew grace, as for out-of-area requests.
      // Security batch A (2026-11-19): exact field set, both ends in Bohol, a plausible road
      // distance, a valid fare equal to the per-km or tariff fare, and only together with the
      // passenger's open-request pointer moved to this booking (one open request at a time,
      // passengerOpenRequest rules).
      allow create: if isSignedIn()
        && isPassenger()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.driverId == null
        && request.resource.data.bookingType == 'standard'
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && isValidStandardBookingShape()
        && isValidLocation(request.resource.data.pickupLocation)
        && isValidLocation(request.resource.data.destination)
        && isInBohol(request.resource.data.pickupLocation)
        && isInBohol(request.resource.data.destination)
        && isPlausibleDistance(
          request.resource.data.distanceKm,
          request.resource.data.pickupLocation,
          request.resource.data.destination
        )
        && isValidFareAmount(request.resource.data.estimatedFare)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(35, 'm')
        && getAfter(openRequestPath(request.auth.uid)).data.kind == 'booking'
        && getAfter(openRequestPath(request.auth.uid)).data.id == bookingId
        && isValidFareBasis();

      allow create: if isSignedIn()
        && isPassenger()
        && isValidOutOfAreaBookingCreate();

      // T1 accept: a verified driver who is online, available, not on another trip, not
      // reserved by an out-of-area proposal, not suspended (by an admin or for overdue commission) and has
      // the requested vehicle type claims an open, unexpired standard booking (bookings
      // without expiresAt, created before expiry existed, count as expired). The same
      // commit must mark the driver unavailable and link drivers/{uid}.currentBookingId.
      allow update: if isVerifiedDriver()
        && resource.data.get('bookingType', 'standard') == 'standard'
        && resource.data.status == 'pending'
        && resource.data.get('driverId', null) == null
        && resource.data.passengerId != request.auth.uid
        && resource.data.get('expiresAt', null) is timestamp
        && request.time < resource.data.expiresAt
        && driverDoc().data.isOnline == true
        && driverDoc().data.isAvailable == true
        && driverDoc().data.get('currentBookingId', null) == null
        && driverDoc().data.get('currentRequestId', null) == null
        && driverDoc().data.vehicleType == resource.data.vehicleType
        && !isAdminSuspended(driverDoc().data)
        && !isCommissionSuspended()
        && request.resource.data.status == 'accepted'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && onlyChanged(['status', 'driverId', 'acceptedAt', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.isAvailable == false
        && getAfter(driverPath(request.auth.uid)).data.get('currentBookingId', null) == bookingId;

      // Out-of-area claim (driverBookingService.claimOutOfAreaBooking): only the driver the
      // passenger agreed with (request.driverId), still reserved for this request and not on
      // another trip, claims the pending booking the passenger created at bookings/{requestId}.
      // The same commit moves the driver's reservation to the booking: currentBookingId set,
      // currentRequestId cleared, not available. A cancelled booking can no longer be claimed.
      allow update: if isVerifiedDriver()
        && resource.data.bookingType == 'out_of_area'
        && resource.data.status == 'pending'
        && resource.data.get('driverId', null) == null
        && resource.data.passengerId != request.auth.uid
        && get(requestPath(bookingId)).data.status == 'accepted'
        && get(requestPath(bookingId)).data.driverId == request.auth.uid
        && driverDoc().data.get('currentRequestId', null) == bookingId
        && driverDoc().data.get('currentBookingId', null) == null
        && driverDoc().data.vehicleType == resource.data.vehicleType
        && request.resource.data.status == 'accepted'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && onlyChanged(['status', 'driverId', 'acceptedAt', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.get('currentBookingId', null) == bookingId
        && getAfter(driverPath(request.auth.uid)).data.get('currentRequestId', null) == null
        && getAfter(driverPath(request.auth.uid)).data.isAvailable == false;

      // T2-T4 and T6: the assigned driver moves the ride forward or cancels before it starts.
      // isDriver() (not isVerifiedDriver) so a driver revoked mid-ride can still finish it.
      allow update: if isAssignedDriver()
        && request.resource.data.updatedAt == request.time
        && (
          // T2 accepted → arrived
          (
            resource.data.status == 'accepted'
            && request.resource.data.status == 'arrived'
            && request.resource.data.arrivedAt == request.time
            && onlyChanged(['status', 'arrivedAt', 'updatedAt'])
          )
          // T3 arrived → in_progress
          || (
            resource.data.status == 'arrived'
            && request.resource.data.status == 'in_progress'
            && request.resource.data.startedAt == request.time
            && onlyChanged(['status', 'startedAt', 'updatedAt'])
          )
          // T4 in_progress → completed (paymentMethod recorded by the driver until Task 4).
          // Once an admin has set a commission, the same commit must record it at
          // commissions/{bookingId} (validated there); without settings there is none.
          || (
            resource.data.status == 'in_progress'
            && request.resource.data.status == 'completed'
            && request.resource.data.completedAt == request.time
            && request.resource.data.paymentMethod in ['cash', 'gcash']
            && request.resource.data.finalFare > 0
            && isExpectedFinalFare()
            && onlyChanged(['status', 'completedAt', 'finalFare', 'paymentMethod', 'updatedAt'])
            && (!exists(commissionSettingsPath()) || existsAfter(commissionPath(bookingId)))
          )
          // T6 driver cancels before the ride starts
          || (
            resource.data.status in ['accepted', 'arrived']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'driver'
            && request.resource.data.cancelledAt == request.time
            && isValidCancelReason()
            && onlyChanged(['status', 'cancelledBy', 'cancellationReason', 'cancelledAt', 'updatedAt'])
          )
        );

      // T5 passenger cancels ("lock with safety exit", 2026-11-08): any time while pending;
      // once accepted only when the driver has not arrived passengerNoShowCancelMinutes()
      // after acceptedAt (server time; acceptedAt is request.time of the accept or claim),
      // recorded with driverNoShowReason(). Never once arrived or in progress. The same rule
      // covers out-of-area bookings after their driver claimed them.
      allow update: if isPassenger()
        && resource.data.passengerId == request.auth.uid
        && (
          resource.data.status == 'pending'
          || (
            resource.data.status == 'accepted'
            && resource.data.get('acceptedAt', null) is timestamp
            && request.time >= resource.data.acceptedAt
              + duration.value(passengerNoShowCancelMinutes(), 'm')
            && request.resource.data.get('cancellationReason', null) == driverNoShowReason()
          )
        )
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'passenger'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidCancelReason()
        && onlyChanged(['status', 'cancelledBy', 'cancellationReason', 'cancelledAt', 'updatedAt']);
    }

    // ─── Out-of-area requests ──────────────────────────────────────────────

    match /outOfAreaRequests/{requestId} {
      // Requests without expiresAt (created before expiry was required) count as expired.
      function isUnexpired() {
        return resource.data.expiresAt is timestamp
          && request.time < resource.data.expiresAt;
      }

      // Admins read every request (Admin Website: Out-of-Area Trips page).
      // Read-only: no admin write rule exists for out-of-area requests.
      allow read: if isAdmin();

      allow read: if isSignedIn()
        && resource.data.passengerId == request.auth.uid;

      // Verified drivers see open requests for their own vehicle type
      // (driverService.subscribeToOpenOutOfAreaRequests filters on status and vehicleType).
      allow read: if isVerifiedDriver()
        && resource.data.status == 'searching'
        && resource.data.vehicleType == driverDoc().data.vehicleType;

      // A verified driver can always read the requests they are handling.
      allow read: if isVerifiedDriver()
        && resource.data.driverId == request.auth.uid;

      // Propose (fareAgreementService.createProposal): a verified driver who is online,
      // available, not on a trip, not already reserved, not suspended (admin or commission)
      // and has the requested vehicle type accepts an open, unexpired request. The fare is
      // locked to the request's admin per-km fare (standardEstimatedFare); drivers no longer
      // choose an amount. The same commit must reserve the driver
      // (drivers/{uid}.currentRequestId = this request, not available). The passenger still
      // has to confirm.
      allow update: if isVerifiedDriver()
        && resource.data.status == 'searching'
        && resource.data.driverId == null
        && resource.data.passengerId != request.auth.uid
        && isUnexpired()
        && driverDoc().data.isOnline == true
        && driverDoc().data.isAvailable == true
        && driverDoc().data.get('currentBookingId', null) == null
        && driverDoc().data.get('currentRequestId', null) == null
        && driverDoc().data.vehicleType == resource.data.vehicleType
        && !isAdminSuspended(driverDoc().data)
        && !isCommissionSuspended()
        && request.resource.data.status == 'negotiating'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.fareAgreement is map
        && request.resource.data.fareAgreement.keys().hasAll([
          'standardEstimatedFare', 'driverProposedFare', 'agreedFare',
          'agreedByPassenger', 'agreedByDriver', 'agreedAt'
        ])
        && request.resource.data.fareAgreement.keys().hasOnly([
          'standardEstimatedFare', 'driverProposedFare', 'agreedFare',
          'agreedByPassenger', 'agreedByDriver', 'agreedAt'
        ])
        && request.resource.data.fareAgreement.driverProposedFare is number
        && request.resource.data.fareAgreement.driverProposedFare == resource.data.standardEstimatedFare
        && request.resource.data.fareAgreement.agreedFare == request.resource.data.fareAgreement.driverProposedFare
        && request.resource.data.fareAgreement.standardEstimatedFare == resource.data.standardEstimatedFare
        && request.resource.data.fareAgreement.agreedByDriver == true
        && request.resource.data.fareAgreement.agreedByPassenger == false
        && request.resource.data.fareAgreement.agreedAt == null
        && request.resource.data.suggestedAgreementFare == request.resource.data.fareAgreement.driverProposedFare
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.get('currentRequestId', null) == requestId
        && getAfter(driverPath(request.auth.uid)).data.isAvailable == false;

      // Withdraw (fareAgreementService.withdrawProposal): the driver handling a request
      // returns it to the open pool before the passenger agrees and releases their own
      // reservation in the same commit. Allowed after expiry too, so a driver is never
      // stuck. Declining an open request needs no write.
      allow update: if isVerifiedDriver()
        && resource.data.driverId == request.auth.uid
        && resource.data.status in ['negotiating', 'driver_interested']
        && request.resource.data.status == 'searching'
        && request.resource.data.driverId == null
        && request.resource.data.suggestedAgreementFare == null
        && request.resource.data.fareAgreement == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.get('currentRequestId', null) == null;

      // Passenger opens a request (bookingService.createOutOfAreaRequest): exactly these
      // fields, no driver or fare agreement yet, server timestamps, and an expiry within
      // 35 min (30 min request setting + 5 min client clock-skew grace).
      allow create: if isSignedIn()
        && isPassenger()
        && request.resource.data.keys().hasAll([
          'passengerId', 'pickupLocation', 'destination', 'vehicleType', 'distanceKm',
          'standardEstimatedFare', 'suggestedAgreementFare', 'agreedFare', 'status',
          'driverId', 'fareAgreement', 'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'passengerId', 'pickupLocation', 'destination', 'vehicleType', 'distanceKm',
          'standardEstimatedFare', 'suggestedAgreementFare', 'agreedFare', 'status',
          'driverId', 'fareAgreement', 'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.driverId == null
        && request.resource.data.suggestedAgreementFare == null
        && request.resource.data.agreedFare == null
        && request.resource.data.fareAgreement == null
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && isValidLocation(request.resource.data.pickupLocation)
        && isValidLocation(request.resource.data.destination)
        // Security batch A (2026-11-19): both ends in the Philippines, a plausible road
        // distance, the admin per-km fare for it (never passenger-chosen), and only together
        // with the passenger's open-request pointer moved to this request.
        && isInPhilippines(request.resource.data.pickupLocation)
        && isInPhilippines(request.resource.data.destination)
        && isPlausibleDistance(
          request.resource.data.distanceKm,
          request.resource.data.pickupLocation,
          request.resource.data.destination
        )
        && isValidFareAmount(request.resource.data.standardEstimatedFare)
        && isPerKmFare(
          request.resource.data.standardEstimatedFare,
          activeFares()[request.resource.data.vehicleType],
          request.resource.data.distanceKm
        )
        && getAfter(openRequestPath(request.auth.uid)).data.kind == 'out_of_area'
        && getAfter(openRequestPath(request.auth.uid)).data.id == requestId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(35, 'm');

      allow update: if isSignedIn()
        && isPassenger()
        && resource.data.passengerId == request.auth.uid
        && (
          // Passenger cancels the request while it is still open
          (
            resource.data.status in ['searching', 'driver_interested', 'negotiating']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          )
          // Passenger accepts the driver's fare (bookingService.acceptProposalAndCreateBooking)
          // before the request expires, creating bookings/{requestId} in the same commit
          // (validated by the bookings create rule). The driver-side fields (driverId,
          // driverProposedFare, agreedByDriver) cannot change and the agreed fare must equal
          // the driver's proposed fare, so a passenger cannot fabricate a different fare or
          // a driver agreement that does not exist.
          || (
            resource.data.status in ['negotiating', 'driver_interested']
            && isUnexpired()
            // The driver must still be verified: an admin may have revoked them after they
            // accepted the request, and a revoked driver could never claim the booking.
            && get(driverPath(resource.data.driverId)).data.get('isVerified', false) == true
            && request.resource.data.status == 'accepted'
            && request.resource.data.agreedFare is number
            && request.resource.data.agreedFare == resource.data.fareAgreement.driverProposedFare
            && request.resource.data.fareAgreement.keys().hasOnly([
              'standardEstimatedFare', 'driverProposedFare', 'agreedFare',
              'agreedByPassenger', 'agreedByDriver', 'agreedAt'
            ])
            && request.resource.data.fareAgreement.agreedFare == resource.data.fareAgreement.driverProposedFare
            && request.resource.data.fareAgreement.agreedByPassenger == true
            && request.resource.data.fareAgreement.agreedAt == request.time
            && request.resource.data.fareAgreement.standardEstimatedFare == resource.data.fareAgreement.standardEstimatedFare
            && request.resource.data.fareAgreement.driverProposedFare == resource.data.fareAgreement.driverProposedFare
            && request.resource.data.fareAgreement.agreedByDriver == resource.data.fareAgreement.agreedByDriver
            && request.resource.data.driverId == resource.data.driverId
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'agreedFare', 'fareAgreement', 'updatedAt'])
            // Created in this commit as the out-of-area booking (not a standard one, which
            // its own create rule would also allow at this id).
            && !exists(bookingPath(requestId))
            && existsAfter(bookingPath(requestId))
            && getAfter(bookingPath(requestId)).data.bookingType == 'out_of_area'
          )
          // Passenger cancels the pending out-of-area booking before the driver claims it
          // (bookingService.cancelBooking): the request is closed in the same commit that
          // cancels bookings/{requestId}, which must still be unclaimed (pending).
          || (
            resource.data.status == 'accepted'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
            && get(bookingPath(requestId)).data.status == 'pending'
            && getAfter(bookingPath(requestId)).data.status == 'cancelled'
          )
          // Passenger declines a pending fare proposal
          || (
            resource.data.status in ['negotiating', 'driver_interested']
            && request.resource.data.status == 'searching'
            && request.resource.data.driverId == null
            && request.resource.data.fareAgreement == null
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt'])
          )
        );
    }

    // ─── One open request per passenger (security batch A, SEC-03) ───────────
    // passengerOpenRequest/{uid} = { kind: 'booking' | 'out_of_area', id, updatedAt }: the
    // passenger's newest standard booking or out-of-area request. The passenger moves it to a
    // booking or request created in the same commit (whose create rules require it), and only
    // while the one it points at is no longer open: a booking that is no longer pending or has
    // expired, a request no longer searching / interested / negotiating or expired. Nothing
    // clears it; cancelling, a driver accepting and expiry close the target. Owner-only.
    match /passengerOpenRequest/{uid} {
      function isOpenTarget(lock) {
        let path = lock.kind == 'booking' ? bookingPath(lock.id) : requestPath(lock.id);
        let target = get(path).data;
        return target.status in (lock.kind == 'booking'
            ? ['pending']
            : ['searching', 'driver_interested', 'negotiating'])
          && target.get('expiresAt', null) is timestamp
          && request.time < target.expiresAt;
      }

      function isValidPointer() {
        let data = request.resource.data;
        let path = data.kind == 'booking' ? bookingPath(data.id) : requestPath(data.id);
        return data.keys().hasAll(['kind', 'id', 'updatedAt'])
          && data.keys().hasOnly(['kind', 'id', 'updatedAt'])
          && data.kind in ['booking', 'out_of_area']
          && data.id is string
          && data.updatedAt == request.time
          // Created in this commit, for this passenger.
          && !exists(path)
          && getAfter(path).data.passengerId == uid;
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidPointer();
      allow update: if isOwner(uid) && isValidPointer() && !isOpenTarget(resource.data);
      allow delete: if false;
    }

    // ─── Ratings ───────────────────────────────────────────────────────────

    // ─── Ratings (2026-11-08, no Cloud Functions) ──────────────────────────
    // One rating per completed booking, by its passenger, within ratingWindowDays() of
    // completion (server time), written in the same commit as the driver's summary
    // driverRatings/{driverId} (ratingSum + stars, ratingCount + 1, lastBookingId). The
    // values below are kept equal to src/constants/rating.ts by
    // tests/booking/ratingSync.test.ts.

    function ratingWindowDays() {
      return 7;
    }

    function ratingCommentMaxLength() {
      return 300;
    }

    function ratingTagIds() {
      return ['on_time', 'safe_driving', 'friendly', 'clean_vehicle', 'good_route', 'late_pickup', 'unsafe_driving', 'rude'];
    }

    function ratingPath(bookingId) {
      return /databases/$(database)/documents/ratings/$(bookingId);
    }

    function driverRatingsPath(driverId) {
      return /databases/$(database)/documents/driverRatings/$(driverId);
    }

    match /ratings/{bookingId} {
      function isValidRatingCreate() {
        let data = request.resource.data;
        let keys = ['bookingId', 'passengerId', 'driverId', 'stars', 'tags', 'comment', 'createdAt'];
        let booking = get(bookingPath(bookingId)).data;
        let summary = getAfter(driverRatingsPath(booking.driverId)).data;
        return isPassenger()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.bookingId == bookingId
          && data.passengerId == request.auth.uid
          && booking.passengerId == request.auth.uid
          && booking.status == 'completed'
          && booking.driverId is string
          && data.driverId == booking.driverId
          && booking.get('completedAt', null) is timestamp
          && request.time < booking.completedAt + duration.value(ratingWindowDays(), 'd')
          && data.stars is int
          && data.stars >= 1
          && data.stars <= 5
          && data.tags is list
          && data.tags.size() <= ratingTagIds().size()
          && data.tags.toSet().size() == data.tags.size()
          && data.tags.toSet().hasOnly(ratingTagIds())
          && (
            data.comment == null
            || (data.comment is string && data.comment.size() <= ratingCommentMaxLength())
          )
          && data.createdAt == request.time
          // The driver's summary is written in this same commit (its rule checks the sums).
          && summary.lastBookingId == bookingId
          && summary.updatedAt == request.time;
      }

      // The passenger reads their own rating; reading one that does not exist yet is
      // allowed so the app can tell whether a trip was rated.
      allow get: if isAdmin()
        || (isSignedIn() && (resource == null || resource.data.passengerId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isValidRatingCreate();
      allow update, delete: if false;
    }

    // driverRatings/{driverId}: { ratingSum, ratingCount, lastBookingId, updatedAt }, the
    // average shown in the app and on the admin website (ratingSum / ratingCount). Written
    // only by the passenger's rating commit; drivers/{uid}.rating is no longer shown.
    match /driverRatings/{driverId} {
      function isRatingSummaryWrite(beforeSum, beforeCount) {
        let data = request.resource.data;
        let bookingId = data.lastBookingId;
        let rating = getAfter(ratingPath(bookingId)).data;
        return isPassenger()
          && data.keys().hasAll(['ratingSum', 'ratingCount', 'lastBookingId', 'updatedAt'])
          && data.keys().hasOnly(['ratingSum', 'ratingCount', 'lastBookingId', 'updatedAt'])
          && bookingId is string
          && data.updatedAt == request.time
          // The rating is created in this commit (its rule checks the booking).
          && !exists(ratingPath(bookingId))
          && existsAfter(ratingPath(bookingId))
          && rating.passengerId == request.auth.uid
          && rating.driverId == driverId
          && data.ratingSum is int
          && data.ratingCount is int
          && data.ratingSum == beforeSum + rating.stars
          && data.ratingCount == beforeCount + 1;
      }

      allow read: if isSignedIn();
      allow create: if isRatingSummaryWrite(0, 0);
      allow update: if isRatingSummaryWrite(resource.data.ratingSum, resource.data.ratingCount);
      allow delete: if false;
    }

    // ─── Drivers (read-only for passengers during driver search) ───────────

    match /drivers/{driverId} {
      // currentBookingId may only be set in the commit that accepts that booking, and only
      // cleared once that booking is completed or cancelled. Unchanged is always fine.
      function isValidCurrentBookingChange() {
        let before = resource.data.get('currentBookingId', null);
        let after = request.resource.data.get('currentBookingId', null);
        return before == after
          || (
            before == null
            && after is string
            && get(bookingPath(after)).data.status == 'pending'
            && getAfter(bookingPath(after)).data.status == 'accepted'
            && getAfter(bookingPath(after)).data.driverId == request.auth.uid
          )
          || (
            before != null
            && after == null
            && getAfter(bookingPath(before)).data.status in ['completed', 'cancelled']
          );
      }

      // A request holds the driver who proposed on it while the passenger may still answer
      // (an unexpired proposal), and once accepted while its booking (bookings/{requestId})
      // still waits for this driver's claim. Claiming moves the hold to currentBookingId; a
      // cancelled booking (or an accepted request without one) holds nobody. Requests
      // without expiresAt (created before expiry was required) hold until withdrawn.
      function requestHoldsDriver(id, data) {
        return data.driverId == request.auth.uid
          && (
            (
              data.status == 'accepted'
              && existsAfter(bookingPath(id))
              && getAfter(bookingPath(id)).data.status == 'pending'
            )
            || (
              data.status in ['driver_interested', 'negotiating']
              && (data.get('expiresAt', null) == null || request.time < data.expiresAt)
            )
          );
      }

      // currentRequestId may only be set in the commit that proposes a fare on that request
      // (searching → negotiating with this driver), and only cleared once the request no
      // longer holds this driver: withdrawn or declined (back to searching), cancelled,
      // expired (status or past expiresAt), rejected, taken by another driver, its booking
      // cancelled, or its booking claimed (in the claim commit).
      function isValidCurrentRequestChange() {
        let before = resource.data.get('currentRequestId', null);
        let after = request.resource.data.get('currentRequestId', null);
        return before == after
          || (
            before == null
            && after is string
            && get(requestPath(after)).data.status == 'searching'
            && getAfter(requestPath(after)).data.status == 'negotiating'
            && getAfter(requestPath(after)).data.driverId == request.auth.uid
          )
          || (
            before != null
            && after == null
            && !requestHoldsDriver(before, getAfter(requestPath(before)).data)
          );
      }

      // Daily acceptance quota (acceptedCount on acceptedDay, see dailyLimit()). Today's
      // count is the stored one when acceptedDay is today, else 0, so a new day starts at
      // 0 with no scheduled job; drivers without the fields count 0.
      // - Standard accept (T1): count + 1, refused when today's count is at the limit.
      // - Out-of-area propose: refused at the limit, count unchanged (a passenger choosing
      //   another driver costs no slot).
      // - Out-of-area claim: count + 1, never refused (the passenger already confirmed).
      // - Release of a booking (currentBookingId cleared): count unchanged, or − 1 when the
      //   passenger cancelled it before the trip started and it was accepted today.
      // - Every other write leaves both fields unchanged.
      function isValidQuotaChange() {
        let before = resource.data;
        let after = request.resource.data;
        let today = manilaDayOf(request.time);
        let todayCount = before.get('acceptedDay', -1) == today ? before.get('acceptedCount', 0) : 0;
        let changed = after.diff(before).affectedKeys().hasAny(['acceptedCount', 'acceptedDay']);
        let bookingBefore = before.get('currentBookingId', null);
        let bookingAfter = after.get('currentBookingId', null);
        return bookingBefore == null && bookingAfter != null
          ? (
            after.get('acceptedDay', null) == today
            && after.get('acceptedCount', null) == todayCount + 1
            && (
              getAfter(bookingPath(bookingAfter)).data.get('bookingType', 'standard') == 'out_of_area'
              || todayCount < dailyLimit()
            )
          )
          : before.get('currentRequestId', null) == null && after.get('currentRequestId', null) != null
            ? !changed && todayCount < dailyLimit()
            : !changed || (bookingBefore != null && bookingAfter == null && isSlotRefund(bookingBefore, today, todayCount));
      }

      // The release gives back the slot of a booking the passenger cancelled before the
      // trip started, accepted today (Manila).
      function isSlotRefund(bookingId, today, todayCount) {
        let booking = getAfter(bookingPath(bookingId)).data;
        return todayCount > 0
          && request.resource.data.get('acceptedDay', null) == today
          && request.resource.data.get('acceptedCount', null) == todayCount - 1
          && booking.status == 'cancelled'
          && booking.get('cancelledBy', null) == 'passenger'
          && booking.get('startedAt', null) == null
          && booking.get('acceptedAt', null) is timestamp
          && manilaDayOf(booking.acceptedAt) == today;
      }

      allow read: if isSignedIn()
        && resource.data.isVerified == true;

      // A driver can always read their own record, including while pending verification.
      allow read: if isOwner(driverId);

      // Admins read every driver record, including revoked and unverified ones (Drivers page).
      allow read: if isAdmin();

      // Admin revokes or restores verification (Drivers page), recording who and when.
      // Revoking needs a reason (shown to admins) and takes the driver offline and
      // unavailable in the same write; the current trip link is untouched, so a driver
      // revoked mid-ride can still finish it (trip updates use isDriver()). Restoring
      // clears the reason and leaves the driver offline until they go online in the app.
      // (The anonymizedAt check comes after onlyChanged: for a driver's own write isAdmin()
      // is an error, not false, so every term up to the first false one is evaluated and
      // counts toward the 1000-expression limit of the driver's commit.)
      allow update: if isAdmin()
        && onlyChanged([
          'isVerified', 'isOnline', 'isAvailable',
          'verificationNote', 'verificationUpdatedAt', 'verificationUpdatedBy'
        ])
        && resource.data.get('anonymizedAt', null) == null
        && request.resource.data.verificationUpdatedAt == request.time
        && request.resource.data.verificationUpdatedBy == request.auth.uid
        && request.resource.data.isOnline == false
        && request.resource.data.isAvailable == false
        && (
          (
            resource.data.get('isVerified', false) == true
            && request.resource.data.isVerified == false
            && request.resource.data.verificationNote is string
            && request.resource.data.verificationNote.size() > 0
            && request.resource.data.verificationNote.size() <= 500
          )
          || (
            resource.data.get('isVerified', false) != true
            && request.resource.data.isVerified == true
            && request.resource.data.get('verificationNote', null) == null
          )
        );

      // Admin corrects the vehicle (Drivers page): only the type, the plate (same format
      // as the driver application), brand, model, color and updatedAt. The result must hold
      // all three details, so a record from before they existed gets them on its first edit.
      // Refused while the driver is on a trip or holding an out-of-area request, so a live
      // booking never sees its vehicle change.
      allow update: if isAdmin()
        && onlyChanged([
          'vehicleType', 'vehiclePlate', 'vehicleBrand', 'vehicleModel', 'vehicleColor', 'updatedAt'
        ])
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && isValidVehiclePlate(request.resource.data.vehiclePlate)
        && isValidVehicleDetails(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && resource.data.get('anonymizedAt', null) == null
        && resource.data.get('currentBookingId', null) == null
        && resource.data.get('currentRequestId', null) == null;

      // Admin suspends the driver (Drivers page), replacing any earlier suspension: only the
      // six suspension fields. suspendedAt is the server time, suspendedUntil a later time
      // or null (until lifted), a reason of 1–500 characters, this admin, and an earlier lift
      // cleared. An adminMessages notice is created in the same commit (not required here).
      // The first term compares a field a driver can never change, so a driver's own commit
      // stops there without evaluating isAdmin() (see the revoke rule above).
      allow update: if request.resource.data.get('suspendedAt', null) != resource.data.get('suspendedAt', null)
        && isAdmin()
        && onlyChanged([
          'suspendedAt', 'suspendedUntil', 'suspensionReason', 'suspendedBy',
          'suspensionLiftedAt', 'suspensionLiftedBy'
        ])
        && resource.data.get('anonymizedAt', null) == null
        && request.resource.data.suspendedAt == request.time
        && (
          request.resource.data.suspendedUntil == null
          || (
            request.resource.data.suspendedUntil is timestamp
            && request.resource.data.suspendedUntil > request.time
          )
        )
        && request.resource.data.suspensionReason is string
        && request.resource.data.suspensionReason.trim().size() > 0
        && request.resource.data.suspensionReason.size() <= 500
        && request.resource.data.suspendedBy == request.auth.uid
        && request.resource.data.suspensionLiftedAt == null
        && request.resource.data.suspensionLiftedBy == null;

      // Admin lifts the current suspension early: once, recording when and who. (An expired
      // suspension may be lifted too; it changes nothing for the driver.) Same first term trick.
      allow update: if request.resource.data.get('suspensionLiftedAt', null) != resource.data.get('suspensionLiftedAt', null)
        && isAdmin()
        && onlyChanged(['suspensionLiftedAt', 'suspensionLiftedBy'])
        && resource.data.get('suspendedAt', null) != null
        && resource.data.get('suspensionLiftedAt', null) == null
        && request.resource.data.suspensionLiftedAt == request.time
        && request.resource.data.suspensionLiftedBy == request.auth.uid;

      // Account deletion (admin website), in the commit that anonymizes users/{uid}: name,
      // plate and vehicle details are blanked, the admin's note and suspension reason removed, and the driver is
      // unverified, offline, unavailable and without a position, for good (restore and
      // vehicle edits are refused afterwards). Refused while the driver is on a trip or
      // holding an out-of-area request. Type, rating and quota count stay (not personal).
      // The key test comes first: it is false for every driver write on a record that was
      // never anonymized, so a driver's own commit stops here without evaluating isAdmin()
      // (an error for drivers, which would keep evaluating and count toward the driver
      // commit's 1000-expression limit). anonymizedAt == request.time is checked below.
      allow update: if 'anonymizedAt' in request.resource.data
        && isAdmin()
        && resource.data.get('anonymizedAt', null) == null
        && resource.data.get('currentBookingId', null) == null
        && resource.data.get('currentRequestId', null) == null
        && onlyChanged([
          'fullName', 'vehiclePlate', 'vehicleBrand', 'vehicleModel', 'vehicleColor',
          'isVerified', 'isOnline', 'isAvailable', 'currentLocation',
          'verificationNote', 'verificationUpdatedAt', 'verificationUpdatedBy', 'anonymizedAt', 'updatedAt',
          'suspensionReason'
        ])
        && request.resource.data.fullName == 'Deleted user'
        && request.resource.data.vehiclePlate == ''
        && request.resource.data.vehicleBrand == ''
        && request.resource.data.vehicleModel == ''
        && request.resource.data.vehicleColor == ''
        && request.resource.data.isVerified == false
        && request.resource.data.isOnline == false
        && request.resource.data.isAvailable == false
        && request.resource.data.currentLocation == null
        && request.resource.data.get('verificationNote', null) == null
        && request.resource.data.get('suspensionReason', null) == null
        && request.resource.data.verificationUpdatedAt == request.time
        && request.resource.data.verificationUpdatedBy == request.auth.uid
        && request.resource.data.anonymizedAt == request.time
        && request.resource.data.updatedAt == request.time
        && isAnonymizedInThisCommit(userPath(driverId));

      // A driver controls only their own duty status, position, current-trip link and
      // proposal reservation, and their quota count only as isValidQuotaChange allows.
      // Admin-managed fields (isVerified, name, vehicle, rating) cannot be changed from the
      // app. Being available requires being online, an unverified driver can only be
      // offline, and a driver linked to a booking or reserved by a proposal is never
      // available. The position is cleared (null) when going offline, so a verified
      // driver's record never shows where they were after their shift; it can be null only
      // while offline, and going online must record one (passenger search needs it).
      allow update: if isOwner(driverId)
        && isDriver()
        && onlyChanged([
          'isOnline', 'isAvailable', 'currentLocation', 'currentBookingId', 'currentRequestId',
          'acceptedCount', 'acceptedDay', 'updatedAt'
        ])
        && request.resource.data.isOnline is bool
        && request.resource.data.isAvailable is bool
        && (!request.resource.data.isAvailable || request.resource.data.isOnline)
        && (
          (!request.resource.data.isOnline && !request.resource.data.isAvailable)
          || resource.data.isVerified == true
        )
        && (
          !('currentLocation' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            request.resource.data.currentLocation == null
            && !request.resource.data.isOnline
          )
          || (
            request.resource.data.currentLocation != null
            && request.resource.data.currentLocation.latitude is number
            && request.resource.data.currentLocation.longitude is number
            // Finite and on Earth (NaN and Infinity fail the comparisons).
            && request.resource.data.currentLocation.latitude >= -90
            && request.resource.data.currentLocation.latitude <= 90
            && request.resource.data.currentLocation.longitude >= -180
            && request.resource.data.currentLocation.longitude <= 180
          )
        )
        // Going online (offline → online) records a position.
        && (
          resource.data.get('isOnline', false) == true
          || !request.resource.data.isOnline
          || request.resource.data.get('currentLocation', null) != null
        )
        && (
          request.resource.data.get('currentBookingId', null) == null
          || request.resource.data.isAvailable == false
        )
        && (
          request.resource.data.get('currentRequestId', null) == null
          || request.resource.data.isAvailable == false
        )
        && isValidCurrentBookingChange()
        && isValidCurrentRequestChange()
        && isValidQuotaChange();

      // An admin creates the record only in the commit that approves this driver's
      // pending application (driver verification on the Admin Website), with exactly
      // these fields: name and plate from the application, a vehicle type, brand, model and
      // color the admin checked (corrections allowed; older applications have no details),
      // verified, offline, no trip, no rating yet. users/{uid}.role stays 'passenger'.
      allow create: if isAdmin()
        && exists(applicationPath(driverId))
        && get(applicationPath(driverId)).data.status == 'pending'
        && getAfter(applicationPath(driverId)).data.status == 'approved'
        && request.resource.data.keys().hasAll([
          'fullName', 'vehiclePlate', 'vehicleType', 'vehicleBrand', 'vehicleModel', 'vehicleColor',
          'isVerified', 'isOnline', 'isAvailable',
          'currentLocation', 'currentBookingId', 'currentRequestId', 'rating', 'profileImage'
        ])
        && request.resource.data.keys().hasOnly([
          'fullName', 'vehiclePlate', 'vehicleType', 'vehicleBrand', 'vehicleModel', 'vehicleColor',
          'isVerified', 'isOnline', 'isAvailable',
          'currentLocation', 'currentBookingId', 'currentRequestId', 'rating', 'profileImage'
        ])
        && request.resource.data.fullName == get(applicationPath(driverId)).data.fullName
        && request.resource.data.vehiclePlate == get(applicationPath(driverId)).data.vehiclePlate
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && isValidVehicleDetails(request.resource.data)
        && request.resource.data.isVerified == true
        && request.resource.data.isOnline == false
        && request.resource.data.isAvailable == false
        && request.resource.data.currentLocation == null
        && request.resource.data.currentBookingId == null
        && request.resource.data.currentRequestId == null
        && request.resource.data.rating == 0
        && request.resource.data.profileImage == null;

      allow delete: if false;
    }

    // ─── Driver applications ───────────────────────────────────────────────
    // One application per passenger at driverApplications/{uid}. Passengers can only
    // submit (always `pending`) or resubmit after a rejection. Approval, rejection,
    // adminRemarks and reviewedAt are set by admins only (Admin Website), so a passenger
    // can never approve themselves. The document photos live in the `documents`
    // subcollection and are written in the same commit as the submit (all or nothing).

    match /driverApplications/{uid} {
      function isValidPersonName(name) {
        return name is string && name.size() >= 1 && name.size() <= 50;
      }

      // A small reference {sizeBytes, uploadedAt} to the photo at
      // driverApplications/{uid}/documents/{documentType}, which must exist after this commit
      // and match it: a photo written in the same commit (submit) or kept from an earlier
      // submission (resubmit without retaking).
      function isValidApplicationDocument(entry, documentType) {
        return entry is map
          && entry.keys().hasAll(['sizeBytes', 'uploadedAt'])
          && entry.keys().hasOnly(['sizeBytes', 'uploadedAt'])
          && existsAfter(applicationDocumentPath(uid, documentType))
          && getAfter(applicationDocumentPath(uid, documentType)).data.sizeBytes == entry.sizeBytes
          && getAfter(applicationDocumentPath(uid, documentType)).data.uploadedAt == entry.uploadedAt;
      }

      // Both required documents (OR/CR and LTO driver's license), nothing else.
      function hasValidDocuments(data) {
        return data.documents is map
          && data.documents.keys().hasAll(['orCr', 'ltoLicense'])
          && data.documents.keys().hasOnly(['orCr', 'ltoLicense'])
          && isValidApplicationDocument(data.documents.orCr, 'orCr')
          && isValidApplicationDocument(data.documents.ltoLicense, 'ltoLicense');
      }

      // Applicant details: structured name, the account's own email and mobile number.
      function hasValidApplicantDetails(data) {
        return isValidPersonName(data.firstName)
          && (data.middleName == null || isValidPersonName(data.middleName))
          && isValidPersonName(data.lastName)
          && data.fullName is string
          && data.fullName.size() <= 160
          && data.email == request.auth.token.email
          && data.mobileNumber == userDoc().data.mobileNumber
          && data.vehicleType in ['tricycle', 'motorcycle']
          && isValidVehiclePlate(data.vehiclePlate)
          && isValidVehicleDetails(data)
          && hasValidDocuments(data);
      }

      // The applicant acknowledges the current Privacy Notice on every submit and resubmit
      // (version and time stored on the application).
      function acknowledgesPrivacyNotice(data) {
        return data.privacyNoticeVersion == currentLegalVersion()
          && data.privacyNoticeAcknowledgedAt == request.time;
      }

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && isPassenger()
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'middleName', 'lastName', 'fullName', 'email', 'mobileNumber',
          'vehicleType', 'vehiclePlate', 'vehicleBrand', 'vehicleModel', 'vehicleColor', 'documents',
          'status', 'adminRemarks', 'submittedAt', 'updatedAt', 'reviewedAt',
          'privacyNoticeVersion', 'privacyNoticeAcknowledgedAt'
        ])
        && request.resource.data.uid == uid
        && hasValidApplicantDetails(request.resource.data)
        && acknowledgesPrivacyNotice(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.adminRemarks == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Controlled resubmission: only after an administrator rejected the application,
      // never once anonymized. uid, adminRemarks and reviewedAt cannot change. An
      // application from before the vehicle details or the privacy acknowledgement existed
      // gains them here (both are required).
      allow update: if isOwner(uid)
        && isPassenger()
        && resource.data.status == 'rejected'
        && resource.data.get('anonymizedAt', null) == null
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'middleName', 'lastName', 'fullName', 'email', 'mobileNumber',
          'vehicleType', 'vehiclePlate', 'vehicleBrand', 'vehicleModel', 'vehicleColor',
          'documents', 'status', 'submittedAt', 'updatedAt',
          'privacyNoticeVersion', 'privacyNoticeAcknowledgedAt'
        ])
        && hasValidApplicantDetails(request.resource.data)
        && acknowledgesPrivacyNotice(request.resource.data)
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Admin review of a pending application. Only status, adminRemarks, reviewedAt and
      // updatedAt change; applicant fields are never edited by the admin.
      function isAdminReview() {
        return isAdmin()
          && resource.data.status == 'pending'
          && resource.data.get('anonymizedAt', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'adminRemarks', 'reviewedAt', 'updatedAt'
          ])
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      function isValidRemarks(remarks) {
        return remarks is string && remarks.size() <= 500 && remarks.trim().size() > 0;
      }

      // Approve: remarks optional, and drivers/{uid} must be created in the same commit
      // (its create rule fixes the field set).
      allow update: if isAdminReview()
        && request.resource.data.status == 'approved'
        && (request.resource.data.adminRemarks == null
          || isValidRemarks(request.resource.data.adminRemarks))
        && !exists(driverPath(uid))
        && existsAfter(driverPath(uid));

      // Reject: remarks required (shown to the applicant), at most 500 characters.
      allow update: if isAdminReview()
        && request.resource.data.status == 'rejected'
        && isValidRemarks(request.resource.data.adminRemarks);

      // Account deletion (admin website), in the commit that anonymizes users/{uid}: names,
      // email, mobile number, plate, vehicle details, document references and the admin's
      // remarks are removed, once, and both document photos are deleted in the same commit.
      // Status, vehicle type, dates and the privacy acknowledgement stay; an anonymized
      // application can no longer be reviewed or resubmitted.
      allow update: if isAdmin()
        && request.resource.data.get('anonymizedAt', null) == request.time
        && resource.data.get('anonymizedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'middleName', 'lastName', 'fullName', 'email', 'mobileNumber',
          'vehiclePlate', 'vehicleBrand', 'vehicleModel', 'vehicleColor', 'documents',
          'adminRemarks', 'anonymizedAt', 'updatedAt'
        ])
        && request.resource.data.firstName == ''
        && request.resource.data.get('middleName', null) == null
        && request.resource.data.lastName == ''
        && request.resource.data.fullName == 'Deleted user'
        && request.resource.data.email == ''
        && request.resource.data.mobileNumber == ''
        && request.resource.data.vehiclePlate == ''
        && request.resource.data.vehicleBrand == ''
        && request.resource.data.vehicleModel == ''
        && request.resource.data.vehicleColor == ''
        && request.resource.data.get('documents', null) == null
        && request.resource.data.get('adminRemarks', null) == null
        && request.resource.data.anonymizedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(applicationDocumentPath(uid, 'orCr'))
        && !existsAfter(applicationDocumentPath(uid, 'ltoLicense'))
        && isAnonymizedInThisCommit(userPath(uid));

      allow delete: if false;

      // ─── Application document photos ─────────────────────────────────────
      // driverApplications/{uid}/documents/{docType} {uid, docType, mimeType, dataBase64,
      // sizeBytes, width, height, uploadedAt}: one compressed JPEG per required document,
      // stored as a base64 STRING, never Firestore bytes: the React Native SDK's bytes
      // decoding crashes on Hermes (Cloud Storage needs the Blaze plan; docs/DECISIONS.md).
      // sizeBytes is the decoded JPEG size (at most 700 000) and must match the text length
      // (4 characters per 3 bytes, minus up to 2 padding bytes; the padding itself is not
      // checked, so 2 bytes of slack; readers check the size exactly). The app never reads
      // these documents.
      // The applicant writes a photo only in the commit that submits or resubmits the
      // application, and only while there is no application yet or it was rejected, so
      // photos never change while pending or after approval, and no photo exists without an
      // application. The applicant may delete their own photos under the same condition;
      // admins may delete any (account deletion). Reads: the applicant and admins only.
      match /documents/{docType} {
        function isApplicationOpenForDocuments() {
          return !exists(applicationPath(uid))
            || (
              get(applicationPath(uid)).data.status == 'rejected'
              && get(applicationPath(uid)).data.get('anonymizedAt', null) == null
            );
        }

        allow read: if isOwner(uid) || isAdmin();

        allow create, update: if isOwner(uid)
          && isPassenger()
          && docType in ['orCr', 'ltoLicense']
          && request.resource.data.keys().hasOnly([
            'uid', 'docType', 'mimeType', 'dataBase64', 'sizeBytes', 'width', 'height', 'uploadedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.docType == docType
          && request.resource.data.mimeType == 'image/jpeg'
          && request.resource.data.dataBase64 is string
          && request.resource.data.dataBase64.size() >= 4
          && request.resource.data.dataBase64.size() <= 950000
          && request.resource.data.dataBase64.size() % 4 == 0
          // A JPEG: base64 of its FF D8 FF signature (security batch A, SEC-15).
          && request.resource.data.dataBase64.matches('/9j/.*')
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes >= 1
          && request.resource.data.sizeBytes <= 700000
          && request.resource.data.sizeBytes * 4 <= request.resource.data.dataBase64.size() * 3
          && request.resource.data.sizeBytes * 4 >= request.resource.data.dataBase64.size() * 3 - 8
          && request.resource.data.width is int
          && request.resource.data.width >= 1
          && request.resource.data.width <= 1600
          && request.resource.data.height is int
          && request.resource.data.height >= 1
          && request.resource.data.height <= 1600
          && request.resource.data.uploadedAt == request.time
          && isApplicationOpenForDocuments()
          // Only together with the submit or resubmit of the application.
          && getAfter(applicationPath(uid)).data.status == 'pending'
          && getAfter(applicationPath(uid)).data.submittedAt == request.time;

        allow delete: if isAdmin()
          || (isOwner(uid) && isApplicationOpenForDocuments());
      }
    }

    // ─── Fare settings ─────────────────────────────────────────────────────
    // fareSettings/active: { fares, outOfArea, booking, updatedAt, updatedBy }. The app reads
    // it (falling back to in-code defaults when missing). Only admins write `fares`, always as
    // a complete object: both vehicle types, each with exactly baseFare and perKm.
    // `outOfArea` and `booking` (standard booking expiry) are written separately (System
    // settings page), also only by admins and always as complete objects; each write
    // changes exactly one of `fares`, `outOfArea` or `booking`.

    match /fareSettings/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /fareSettings/active {
      function isValidVehicleFare(fare) {
        return fare is map
          && fare.keys().hasAll(['baseFare', 'perKm'])
          && fare.keys().hasOnly(['baseFare', 'perKm'])
          && fare.baseFare is number
          && fare.baseFare >= 0
          && hasAtMostTwoDecimals(fare.baseFare)
          && fare.perKm is number
          && fare.perKm > 0
          && hasAtMostTwoDecimals(fare.perKm);
      }

      function isValidFares(fares) {
        return fares is map
          && fares.keys().hasAll(['tricycle', 'motorcycle'])
          && fares.keys().hasOnly(['tricycle', 'motorcycle'])
          && isValidVehicleFare(fares.tricycle)
          && isValidVehicleFare(fares.motorcycle);
      }

      function isValidFareWrite() {
        return isAdmin()
          && isValidFares(request.resource.data.fares)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
      }

      // Whole minutes and kilometres. The app also caps the expiry it writes at 30 minutes
      // (the outOfAreaRequests create rule allows up to 35 for clock skew).
      function isValidOutOfArea(value) {
        let keys = ['enabled', 'requestExpiryMinutes', 'driverSearchRadiusKm'];
        return value is map
          && value.keys().hasAll(keys)
          && value.keys().hasOnly(keys)
          && value.enabled is bool
          && value.requestExpiryMinutes is int
          && value.requestExpiryMinutes >= 1
          && value.requestExpiryMinutes <= 30
          && value.driverSearchRadiusKm is int
          && value.driverSearchRadiusKm >= 1
          && value.driverSearchRadiusKm <= 50;
      }

      function isValidOutOfAreaWrite() {
        return isAdmin()
          && isValidOutOfArea(request.resource.data.outOfArea)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
      }

      // Standard booking expiry in whole minutes. Same 1-30 range as out-of-area, so the
      // bookings create rule's 35-minute cap covers it.
      function isValidBookingSettings(value) {
        return value is map
          && value.keys().hasAll(['requestExpiryMinutes'])
          && value.keys().hasOnly(['requestExpiryMinutes'])
          && value.requestExpiryMinutes is int
          && value.requestExpiryMinutes >= 1
          && value.requestExpiryMinutes <= 30;
      }

      function isValidBookingSettingsWrite() {
        return isAdmin()
          && isValidBookingSettings(request.resource.data.booking)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
      }

      allow create: if (isValidFareWrite()
          && request.resource.data.keys().hasOnly(['fares', 'updatedAt', 'updatedBy']))
        || (isValidOutOfAreaWrite()
          && request.resource.data.keys().hasOnly(['outOfArea', 'updatedAt', 'updatedBy']))
        || (isValidBookingSettingsWrite()
          && request.resource.data.keys().hasOnly(['booking', 'updatedAt', 'updatedBy']));

      allow update: if (isValidFareWrite()
          && onlyChanged(['fares', 'updatedAt', 'updatedBy']))
        || (isValidOutOfAreaWrite()
          && onlyChanged(['outOfArea', 'updatedAt', 'updatedBy']))
        || (isValidBookingSettingsWrite()
          && onlyChanged(['booking', 'updatedAt', 'updatedBy']));
    }

    // ─── Barangay tariffs ──────────────────────────────────────────────────
    // barangayTariffs/{barangayId}: the fixed per-trip tariff between Poblacion and one of
    // the 19 other barangays of Trinidad, per vehicle type. One document per barangay
    // (a single map of all 19 would exceed the rules expression limit to validate).
    // Only admins write, always the complete row. Standard booking create checks a
    // barangay_tariff fare against the active row (isTariffFare in bookings).

    match /barangayTariffs/{barangayId} {
      // Known IDs and their names. Keep in sync with admin/src/tariffs/barangays.ts.
      function barangayNames() {
        return {
          'banlasan': 'Banlasan',
          'bongbong': 'Bongbong',
          'catoogan': 'Catoogan',
          'guinobatan': 'Guinobatan',
          'hinlayagan-ilaud': 'Hinlayagan Ilaud',
          'hinlayagan-ilaya': 'Hinlayagan Ilaya',
          'kauswagan': 'Kauswagan',
          'kinan-oan': 'Kinan-oan',
          'la-union': 'La Union',
          'la-victoria': 'La Victoria',
          'mabuhay-cabigohan': 'Mabuhay Cabigohan',
          'mahagbu': 'Mahagbu',
          'manuel-m-roxas': 'Manuel M. Roxas',
          'san-isidro': 'San Isidro',
          'san-vicente': 'San Vicente',
          'santo-tomas': 'Santo Tomas',
          'soom': 'Soom',
          'tagum-norte': 'Tagum Norte',
          'tagum-sur': 'Tagum Sur'
        };
      }

      function isValidTariff(value) {
        return value is number && value > 0 && hasAtMostTwoDecimals(value);
      }

      function isValidTariffWrite() {
        let data = request.resource.data;
        let keys = ['name', 'tricycle', 'motorcycle', 'active', 'updatedAt', 'updatedBy'];
        return isAdmin()
          && barangayId in barangayNames()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.name == barangayNames()[barangayId]
          && isValidTariff(data.tricycle)
          && isValidTariff(data.motorcycle)
          && data.active is bool
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid;
      }

      allow read: if isSignedIn();
      allow create, update: if isValidTariffWrite();
      allow delete: if false;
    }

    // ─── Commission settings ───────────────────────────────────────────────
    // commissionSettings/active: { percentage, paymentPeriodDays, gracePeriodDays,
    // updatedAt, updatedBy }. Commission = percentage of the final fare (docs/DECISIONS.md).
    // Admins write, always the complete object. Admins and anyone with a drivers/{uid}
    // record (including a revoked driver, who may still owe commission) read it, so the
    // driver app can show and apply the percentage it charges. Passengers cannot read it.
    // Commission is recorded on every completed trip (Commission accrual below) and paid by
    // GCash, confirmed by an admin (Commission payments). Enforcement comes in a later step.

    match /commissionSettings/active {
      function isValidCommissionWrite() {
        let data = request.resource.data;
        let keys = ['percentage', 'paymentPeriodDays', 'gracePeriodDays', 'updatedAt', 'updatedBy'];
        return isAdmin()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.percentage is number
          && data.percentage > 0
          && data.percentage <= 100
          && hasAtMostTwoDecimals(data.percentage)
          && data.paymentPeriodDays is int
          && data.paymentPeriodDays >= 1
          && data.paymentPeriodDays <= 31
          && data.gracePeriodDays is int
          && data.gracePeriodDays >= 0
          && data.gracePeriodDays <= 14
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid;
      }

      allow read: if isAdmin()
        || (isSignedIn() && exists(driverPath(request.auth.uid)));
      allow create, update: if isValidCommissionWrite();
      allow delete: if false;
    }

    // ─── Quota settings ────────────────────────────────────────────────────
    // quotaSettings/active: { dailyLimit, updatedAt, updatedBy }. One daily acceptance
    // limit (whole number 1-100) for every driver, each counted separately (drivers rules,
    // isValidQuotaChange). Always active; while the document is missing the limit is
    // defaultDailyLimit(). Admins write the complete object (Quota page); every signed-in
    // user reads it (drivers for their gate, passengers to leave drivers at their limit
    // out of the out-of-area driver search).

    match /quotaSettings/active {
      function isValidQuotaWrite() {
        let data = request.resource.data;
        let keys = ['dailyLimit', 'updatedAt', 'updatedBy'];
        return isAdmin()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.dailyLimit is int
          && data.dailyLimit >= 1
          && data.dailyLimit <= 100
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid;
      }

      allow read: if isSignedIn();
      allow create, update: if isValidQuotaWrite();
      allow delete: if false;
    }

    // ─── Payment settings ──────────────────────────────────────────────────
    // paymentSettings/active: { gcashName, gcashNumber, updatedAt, updatedBy }. TriGo's GCash
    // account that drivers pay commission to (System settings page). TriGo moves no money:
    // drivers pay in GCash and report the reference; an admin verifies it (docs/DECISIONS.md).
    // Admins write, always the complete object; admins and drivers (same as
    // commissionSettings) read. gcashNumber is stored as 11 digits, e.g. 09171234567.

    match /paymentSettings/active {
      function isValidPaymentSettingsWrite() {
        let data = request.resource.data;
        let keys = ['gcashName', 'gcashNumber', 'updatedAt', 'updatedBy'];
        return isAdmin()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.gcashName is string
          && data.gcashName.size() > 0
          && data.gcashName.size() <= 60
          && data.gcashName == data.gcashName.trim()
          && data.gcashNumber is string
          && data.gcashNumber.matches('^09[0-9]{9}$')
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid;
      }

      allow read: if isAdmin()
        || (isSignedIn() && exists(driverPath(request.auth.uid)));
      allow create, update: if isValidPaymentSettingsWrite();
      allow delete: if false;
    }

    // ─── Commission accrual ────────────────────────────────────────────────
    // When an admin has set commissionSettings/active, completing a trip (T4,
    // driverBookingService.completeTrip) records its commission in the same commit:
    //   commissions/{bookingId}: { driverId, bookingId, bookingType, finalFare, percentage,
    //     amountCentavos, periodSeq, completedAt }, amount = round(finalFare × percentage)
    //     centavos (= finalFare × percentage / 100 pesos, to the centavo), percentage snapshot.
    //   commissionAccounts/{driverId}: { driverId, accruedCentavos, paidCentavos,
    //     current: { seq, startAt, periodDays, graceDays, startCentavos },
    //     unpaid: null | { seq, startAt, periodDays, graceDays }, lastBookingId, updatedAt,
    //     lastPaymentId (after the first confirmed payment) }. Running totals in integer
    //     centavos; confirmed payments pay the oldest debt first (Commission payments).
    //   commissionPeriods/{driverId}_{seq}: { driverId, seq, startAt, periodDays, graceDays,
    //     startCentavos }, written when a period opens.
    // A driver's first commission opens period 1. A period ends at periodEndMillis(startAt,
    // periodDays) (Manila midnight); the grace period ends graceDays later. The first
    // completion at or after the end opens the next period (period and grace days copied
    // from the settings at that moment); the closed period becomes `unpaid` when it is the
    // oldest one not fully paid. Only server time (request.time) is stored, never a time
    // the app computed. Drivers read their own documents; admins read all. Nobody deletes.

    match /commissions/{bookingId} {
      function isValidCommissionCreate() {
        let data = request.resource.data;
        let keys = [
          'driverId', 'bookingId', 'bookingType', 'finalFare', 'percentage', 'amountCentavos',
          'periodSeq', 'completedAt'
        ];
        let booking = get(bookingPath(bookingId)).data;
        let completed = getAfter(bookingPath(bookingId)).data;
        let settings = get(commissionSettingsPath()).data;
        let account = getAfter(commissionAccountPath(request.auth.uid)).data;
        return isSignedIn()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.driverId == request.auth.uid
          && data.bookingId == bookingId
          // Only in the commit that completes this driver's trip.
          && booking.status == 'in_progress'
          && booking.driverId == request.auth.uid
          && completed.status == 'completed'
          && data.bookingType == booking.get('bookingType', 'standard')
          && data.finalFare == completed.finalFare
          && data.percentage == settings.percentage
          && data.amountCentavos == math.round(completed.finalFare * settings.percentage * 1.0)
          // Never negative, so only a confirmed payment lowers what a driver owes.
          && data.amountCentavos >= 0
          && account.lastBookingId == bookingId
          && data.periodSeq == account.current.seq
          && data.completedAt == request.time;
      }

      allow read: if isAdmin();
      allow read: if isSignedIn() && resource.data.driverId == request.auth.uid;
      allow create: if isValidCommissionCreate();
      allow update, delete: if false;
    }

    match /commissionAccounts/{driverId} {
      // The commission created in this commit (lastBookingId); it must be new.
      function newCommission() {
        return getAfter(commissionPath(request.resource.data.lastBookingId)).data;
      }

      function recordsNewCommission() {
        return request.resource.data.lastBookingId is string
          && !exists(commissionPath(request.resource.data.lastBookingId))
          && newCommission().driverId == driverId;
      }

      // A period opened now, with the current settings.
      function openedPeriod(seq, startCentavos) {
        let settings = get(commissionSettingsPath()).data;
        return {
          'seq': seq,
          'startAt': request.time,
          'periodDays': settings.paymentPeriodDays,
          'graceDays': settings.gracePeriodDays,
          'startCentavos': startCentavos
        };
      }

      // The oldest closed period not fully paid after the current one closes: unchanged when
      // an older one is unpaid, else the closing period when anything is still owed.
      function unpaidAfterClosing(before) {
        return before.unpaid != null
          ? before.unpaid
          : (
            before.paidCentavos < before.accruedCentavos
              ? {
                'seq': before.current.seq,
                'startAt': before.current.startAt,
                'periodDays': before.current.periodDays,
                'graceDays': before.current.graceDays
              }
              : null
          );
      }

      allow read: if isAdmin() || isOwner(driverId);

      // The driver's first commission opens period 1.
      allow create: if isOwner(driverId)
        && request.resource.data.keys().hasAll([
          'driverId', 'accruedCentavos', 'paidCentavos', 'current', 'unpaid', 'lastBookingId',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'driverId', 'accruedCentavos', 'paidCentavos', 'current', 'unpaid', 'lastBookingId',
          'updatedAt'
        ])
        && request.resource.data.driverId == driverId
        && recordsNewCommission()
        && request.resource.data.accruedCentavos == newCommission().amountCentavos
        && request.resource.data.paidCentavos == 0
        && request.resource.data.current == openedPeriod(1, 0)
        && request.resource.data.unpaid == null
        && request.resource.data.updatedAt == request.time
        && existsAfter(commissionPeriodPath(driverId, 1));

      // Each later commission adds to the total, in its period or, once that period has
      // ended, in a new one.
      allow update: if isOwner(driverId)
        && recordsNewCommission()
        && request.resource.data.accruedCentavos
          == resource.data.accruedCentavos + newCommission().amountCentavos
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.time.toMillis()
              < periodEndMillis(resource.data.current.startAt, resource.data.current.periodDays)
            && onlyChanged(['accruedCentavos', 'lastBookingId', 'updatedAt'])
          )
          || (
            request.time.toMillis()
              >= periodEndMillis(resource.data.current.startAt, resource.data.current.periodDays)
            && onlyChanged(['accruedCentavos', 'lastBookingId', 'updatedAt', 'current', 'unpaid'])
            && request.resource.data.current
              == openedPeriod(resource.data.current.seq + 1, resource.data.accruedCentavos)
            && request.resource.data.unpaid == unpaidAfterClosing(resource.data)
            && existsAfter(commissionPeriodPath(driverId, resource.data.current.seq + 1))
          )
        );

      // Where a closed period's debt ends: the next period's start total (the current
      // period's when it is the next one).
      function nextStartCentavos(before, seq) {
        return seq + 1 == before.current.seq
          ? before.current.startCentavos
          : get(commissionPeriodPath(driverId, seq + 1)).data.startCentavos;
      }

      // After paying up to `paid` (oldest debt first): no unpaid period once every closed
      // period is paid, else the closed period s with startCentavos(s) <= paid <
      // startCentavos(s + 1), copied from its period document.
      function isUnpaidAfterPaying(before, paid, unpaid) {
        return paid >= before.current.startCentavos
          ? unpaid == null
          : (
            unpaid != null
            && unpaid.seq is int
            && unpaid.seq >= 1
            && unpaid.seq < before.current.seq
            && isPeriodOwing(before, paid, unpaid, get(commissionPeriodPath(driverId, unpaid.seq)).data)
          );
      }

      function isPeriodOwing(before, paid, unpaid, period) {
        return unpaid == {
            'seq': period.seq,
            'startAt': period.startAt,
            'periodDays': period.periodDays,
            'graceDays': period.graceDays
          }
          && period.startCentavos <= paid
          && paid < nextStartCentavos(before, unpaid.seq);
      }

      // Admin confirms a payment (Earnings page): in the commit that confirms it, paid
      // grows by the payment, never past what was recorded, and the unpaid pointer moves to
      // the oldest period still owed.
      allow update: if isAdmin()
        && onlyChanged(['paidCentavos', 'unpaid', 'lastPaymentId', 'updatedAt'])
        && isConfirmedInThisCommit(request.resource.data.lastPaymentId)
        && get(paymentPath(request.resource.data.lastPaymentId)).data.driverId == driverId
        && request.resource.data.paidCentavos
          == resource.data.paidCentavos
            + get(paymentPath(request.resource.data.lastPaymentId)).data.amountCentavos
        && request.resource.data.paidCentavos <= resource.data.accruedCentavos
        && request.resource.data.updatedAt == request.time
        && isUnpaidAfterPaying(resource.data, request.resource.data.paidCentavos, request.resource.data.unpaid);

      allow delete: if false;
    }

    match /commissionPeriods/{periodId} {
      // Written in the commit that opens the period on the driver's account.
      function isValidPeriodCreate() {
        let data = request.resource.data;
        let keys = ['driverId', 'seq', 'startAt', 'periodDays', 'graceDays', 'startCentavos'];
        let current = getAfter(commissionAccountPath(request.auth.uid)).data.current;
        return isSignedIn()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.driverId == request.auth.uid
          && data.seq is int
          && periodId == request.auth.uid + '_' + string(data.seq)
          && current.startAt == request.time
          && data.seq == current.seq
          && data.startAt == current.startAt
          && data.periodDays == current.periodDays
          && data.graceDays == current.graceDays
          && data.startCentavos == current.startCentavos;
      }

      allow read: if isAdmin();
      allow read: if isSignedIn() && resource.data.driverId == request.auth.uid;
      allow create: if isValidPeriodCreate();
      allow update, delete: if false;
    }

    // ─── Commission payments ───────────────────────────────────────────────
    // A driver pays by GCash outside the app, then reports it (Earnings tab):
    //   commissionPayments/{autoId}: { driverId, amountCentavos, reference, status: 'pending',
    //     submittedAt }; an admin later sets status 'confirmed' or 'rejected' (with
    //     rejectionReason), reviewedAt and reviewedBy (Earnings page).
    //   paymentReferences/{reference}: { paymentId, driverId, createdAt }, created in the same
    //     commit. Creating fails when the document exists, so a GCash reference number can be
    //     submitted only once. Rejecting deletes it so the right payment can be resubmitted;
    //     a confirmed reference stays forever.
    // The amount is ₱1.00 up to the balance (accrued − confirmed paid); pending payments are
    // not subtracted, the confirm caps paid at accrued instead. Confirming credits the
    // driver's account (lastPaymentId, oldest debt first) and earningsLedger/totals
    // (collectedCentavos) in the same commit. Nobody deletes payments.

    match /commissionPayments/{paymentId} {
      function isValidPaymentCreate() {
        let data = request.resource.data;
        let keys = ['driverId', 'amountCentavos', 'reference', 'status', 'submittedAt'];
        let account = get(commissionAccountPath(request.auth.uid)).data;
        return isSignedIn()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.driverId == request.auth.uid
          && data.amountCentavos is int
          && data.amountCentavos >= 100
          && data.amountCentavos <= account.accruedCentavos - account.paidCentavos
          && data.reference is string
          && data.reference.matches('^[0-9]{10,20}$')
          && data.status == 'pending'
          && data.submittedAt == request.time
          && getAfter(paymentReferencePath(data.reference)).data.paymentId == paymentId;
      }

      function isValidPaymentReview() {
        let data = request.resource.data;
        return isAdmin()
          && resource.data.status == 'pending'
          && data.reviewedAt == request.time
          && data.reviewedBy == request.auth.uid
          && (
            (
              data.status == 'confirmed'
              && onlyChanged(['status', 'reviewedAt', 'reviewedBy'])
              && getAfter(commissionAccountPath(resource.data.driverId)).data.lastPaymentId == paymentId
              && getAfter(ledgerPath()).data.lastPaymentId == paymentId
            )
            || (
              data.status == 'rejected'
              && onlyChanged(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy'])
              && data.rejectionReason is string
              && data.rejectionReason.trim().size() > 0
              && data.rejectionReason.size() <= 300
              && !existsAfter(paymentReferencePath(resource.data.reference))
            )
          );
      }

      allow read: if isAdmin();
      allow read: if isSignedIn() && resource.data.driverId == request.auth.uid;
      allow create: if isValidPaymentCreate();
      allow update: if isValidPaymentReview();
      allow delete: if false;
    }

    match /paymentReferences/{reference} {
      // Created with the payment that uses it (new in this commit, same driver).
      function isValidReferenceCreate() {
        let data = request.resource.data;
        let keys = ['paymentId', 'driverId', 'createdAt'];
        let payment = getAfter(paymentPath(data.paymentId)).data;
        return isSignedIn()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.driverId == request.auth.uid
          && data.createdAt == request.time
          && data.paymentId is string
          && !exists(paymentPath(data.paymentId))
          && payment.driverId == request.auth.uid
          && payment.reference == reference;
      }

      // A driver can check a reference that is free or their own (to explain a refusal);
      // another driver's reference is not readable.
      allow get: if isAdmin()
        || (isSignedIn() && (resource == null || resource.data.driverId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isValidReferenceCreate();
      // Freed only by rejecting its pending payment in the same commit.
      allow delete: if isAdmin()
        && get(paymentPath(resource.data.paymentId)).data.status == 'pending'
        && getAfter(paymentPath(resource.data.paymentId)).data.status == 'rejected';
      allow update: if false;
    }

    // earningsLedger/totals: { collectedCentavos, cashedOutCentavos, lastPaymentId,
    // lastCashOutId (after the first cash-out), updatedAt }. Commission TriGo has collected
    // (confirmed payments) and cashed out. Created by the first confirm. Admins only.
    match /earningsLedger/totals {
      function isPaymentCredit() {
        return isConfirmedInThisCommit(request.resource.data.lastPaymentId)
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['collectedCentavos', 'cashedOutCentavos', 'lastPaymentId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['collectedCentavos', 'cashedOutCentavos', 'lastPaymentId', 'updatedAt'])
        && isPaymentCredit()
        && request.resource.data.collectedCentavos
          == get(paymentPath(request.resource.data.lastPaymentId)).data.amountCentavos
        && request.resource.data.cashedOutCentavos == 0;
      allow update: if isAdmin()
        && onlyChanged(['collectedCentavos', 'lastPaymentId', 'updatedAt'])
        && isPaymentCredit()
        && request.resource.data.collectedCentavos
          == resource.data.collectedCentavos
            + get(paymentPath(request.resource.data.lastPaymentId)).data.amountCentavos;
      // A cash-out created in this commit adds its amount; never more than collected.
      allow update: if isAdmin()
        && onlyChanged(['cashedOutCentavos', 'lastCashOutId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastCashOutId is string
        && !exists(cashOutPath(request.resource.data.lastCashOutId))
        && request.resource.data.cashedOutCentavos
          == resource.data.cashedOutCentavos
            + getAfter(cashOutPath(request.resource.data.lastCashOutId)).data.amountCentavos
        && request.resource.data.cashedOutCentavos <= resource.data.collectedCentavos;
      allow delete: if false;
    }

    // ─── Cash-outs ─────────────────────────────────────────────────────────
    // cashOuts/{autoId}: { method: gcash / maya / bank_transfer, amountCentavos, reference,
    // cashedOutOn ('YYYY-MM-DD'), note ('' when none), createdAt, createdBy }. A record of
    // commission an admin moved out of TriGo's GCash in the real GCash, Maya or bank app;
    // TriGo moves no money. Created with the earningsLedger/totals update that adds it to
    // cashedOutCentavos (at most collectedCentavos). Immutable: mistakes are corrected by
    // a later decision, never by editing or deleting.

    match /cashOuts/{cashOutId} {
      function isValidCashOutCreate() {
        let data = request.resource.data;
        let keys = ['method', 'amountCentavos', 'reference', 'cashedOutOn', 'note', 'createdAt', 'createdBy'];
        return isAdmin()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.method in ['gcash', 'maya', 'bank_transfer']
          && data.amountCentavos is int
          && data.amountCentavos > 0
          && data.reference is string
          && data.reference.trim().size() > 0
          && data.reference.size() <= 60
          && data.cashedOutOn is string
          && data.cashedOutOn.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && data.note is string
          && data.note.size() <= 300
          && data.createdAt == request.time
          && data.createdBy == request.auth.uid
          && getAfter(ledgerPath()).data.lastCashOutId == cashOutId;
      }

      allow read: if isAdmin();
      allow create: if isValidCashOutCreate();
      allow update, delete: if false;
    }

    // ─── Support contacts ──────────────────────────────────────────────────
    // supportContacts/{contactId}: { label, phone, active, sortOrder, updatedAt, updatedBy }.
    // Shown on the app's Help screen (active ones only, tap to call). Admins read, write
    // (always the complete document) and delete; signed-in users read active contacts.

    match /supportContacts/{contactId} {
      function isValidContactWrite() {
        let data = request.resource.data;
        let keys = ['label', 'phone', 'active', 'sortOrder', 'updatedAt', 'updatedBy'];
        return isAdmin()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.label is string
          && data.label.trim().size() > 0
          && data.label.size() <= 60
          && data.phone is string
          && data.phone.matches('[+]?[0-9 ()-]{6,19}[0-9]')
          && data.active is bool
          && data.sortOrder is int
          && data.sortOrder >= 0
          && data.sortOrder <= 99
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid;
      }

      allow read: if isAdmin() || (isSignedIn() && resource.data.active == true);
      allow create, update: if isValidContactWrite();
      allow delete: if isAdmin();
    }

    // ─── Admin messages ("messages from TriGo") ──────────────────────────────
    //
    // adminMessages/{messageId}: { userId, kind, title, body, reason, until, refId?, createdBy,
    // createdAt, readAt }. Always created by an admin in the same commit as the decision it
    // reports, and each kind is checked against the document that decision changes:
    //   Drivers page: 'suspended', 'suspension_lifted', 'revoked', 'restored' (reason
    //     required; until = suspension end or null; no refId).
    //   System notices (2026-11-19), until null:
    //     'application_approved' / 'application_rejected': driverApplications/{userId}
    //       reviewed now with that status; reason '' / exactly the stored adminRemarks.
    //     'payment_confirmed' / 'payment_rejected': refId = commissionPayments ID, the
    //       user's payment reviewed now with that status; reason '' / the rejectionReason.
    //     'report_resolved': refId = complaint ID, the user's own report resolved now;
    //       reason always '' (the admin's note and the outcome stay private).
    //     'deletion_declined': deletionRequests/{userId} declined now; reason = declineNote.
    // The user reads only their own and sets readAt once; in the commit that anonymizes the
    // user an admin clears reason and body (the record stays). Nobody deletes.
    match /adminMessages/{messageId} {
      function isValidAdminMessageCreate() {
        let data = request.resource.data;
        let keys = ['userId', 'kind', 'title', 'body', 'reason', 'until', 'createdBy', 'createdAt', 'readAt'];
        return isAdmin()
          && data.keys().hasOnly(['userId', 'kind', 'title', 'body', 'reason', 'until', 'refId', 'createdBy', 'createdAt', 'readAt'])
          && data.keys().hasAll(keys)
          && data.userId is string
          && data.userId.size() > 0
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 120
          && data.body is string
          && data.body.size() > 0
          && data.body.size() <= 1000
          && data.reason is string
          && data.reason.size() <= 500
          && (data.until == null || data.until is timestamp)
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time
          && data.readAt == null
          && isValidMessageKind(data);
      }

      function isValidMessageKind(data) {
        return data.kind in ['suspended', 'suspension_lifted', 'revoked', 'restored']
          ? (data.reason.trim().size() > 0 && data.get('refId', null) == null)
          : (data.until == null && isValidNotice(data));
      }

      function isValidNotice(data) {
        return data.kind == 'application_approved' ? isApplicationNotice(data, 'approved')
          : data.kind == 'application_rejected' ? isApplicationNotice(data, 'rejected')
          : data.kind == 'payment_confirmed' ? isPaymentNotice(data, 'confirmed')
          : data.kind == 'payment_rejected' ? isPaymentNotice(data, 'rejected')
          : data.kind == 'report_resolved' ? isReportNotice(data)
          : data.kind == 'deletion_declined' ? isDeletionNotice(data)
          : false;
      }

      function isApplicationNotice(data, status) {
        let application = getAfter(applicationPath(data.userId)).data;
        return data.get('refId', null) == null
          && application.status == status
          && application.reviewedAt == request.time
          && data.reason == (status == 'rejected' ? application.adminRemarks : '');
      }

      function isPaymentNotice(data, status) {
        let payment = getAfter(paymentPath(data.refId)).data;
        return data.refId is string
          && payment.driverId == data.userId
          && payment.status == status
          && payment.reviewedAt == request.time
          && data.reason == (status == 'rejected' ? payment.rejectionReason : '');
      }

      function isReportNotice(data) {
        let complaint = getAfter(/databases/$(database)/documents/complaints/$(data.refId)).data;
        return data.refId is string
          && complaint.reporterId == data.userId
          && complaint.status == 'resolved'
          && complaint.resolvedAt == request.time
          && data.reason == '';
      }

      function isDeletionNotice(data) {
        let deletion = getAfter(deletionRequestPath(data.userId)).data;
        return data.get('refId', null) == null
          && deletion.status == 'declined'
          && deletion.declinedAt == request.time
          && data.reason == deletion.declineNote;
      }

      function isMarkRead() {
        return isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.readAt == null
          && onlyChanged(['readAt'])
          && request.resource.data.readAt == request.time;
      }

      // Account deletion: reason and body are cleared in the commit that anonymizes users/{uid}.
      function isTextCleared() {
        let data = request.resource.data;
        return isAdmin()
          && onlyChanged(['reason', 'body', 'reasonClearedAt'])
          && data.reason == ''
          && data.body == ''
          && isAnonymizedInThisCommit(userPath(resource.data.userId))
          && data.reasonClearedAt == request.time;
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidAdminMessageCreate();
      allow update: if isMarkRead() || isTextCleared();
      allow delete: if false;
    }

    // ─── Announcements (admin → many users) ─────────────────────────────────
    //
    // announcements/{id}: { title, body, audience ('all' | 'passengers' | 'drivers'),
    // showUntil (a later time, or null = until withdrawn), status ('active' | 'withdrawn'),
    // createdBy, createdAt, withdrawnAt, withdrawnBy }. ONE document per announcement, never
    // one per user. Admins create and withdraw (Admin Website → Announcements); nobody edits
    // the text or deletes. Signed-in users read the active ones of their audience:
    // passengers = passenger accounts (isPassenger), drivers = the driver role (isDriver: driver
    // accounts and approved applicants). The app queries one audience at a time with
    // status == 'active', so each query is decided by its own audience. showUntil only hides
    // an announcement in the app; it stays readable until withdrawn.
    match /announcements/{announcementId} {
      function isAnnouncementAudience(audience) {
        return audience == 'all'
          || (audience == 'passengers' && isPassenger())
          || (audience == 'drivers' && isDriver());
      }

      function isValidAnnouncementCreate() {
        let data = request.resource.data;
        let keys = ['title', 'body', 'audience', 'showUntil', 'status', 'createdBy', 'createdAt', 'withdrawnAt', 'withdrawnBy'];
        return isAdmin()
          && data.keys().hasOnly(keys)
          && data.keys().hasAll(keys)
          && data.title is string
          && data.title.trim().size() > 0
          && data.title.size() <= 120
          && data.body is string
          && data.body.trim().size() > 0
          && data.body.size() <= 1000
          && data.audience in ['all', 'passengers', 'drivers']
          && (data.showUntil == null || (data.showUntil is timestamp && data.showUntil > request.time))
          && data.status == 'active'
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time
          && data.withdrawnAt == null
          && data.withdrawnBy == null;
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.status == 'active' && isAnnouncementAudience(resource.data.audience));
      allow create: if isValidAnnouncementCreate();
      // Withdraw: it leaves every inbox at once (the app reads only active ones).
      allow update: if isAdmin()
        && resource.data.status == 'active'
        && onlyChanged(['status', 'withdrawnAt', 'withdrawnBy'])
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.withdrawnAt == request.time
        && request.resource.data.withdrawnBy == request.auth.uid;
      allow delete: if false;
    }

    // users/{uid}/inboxState/announcements: { lastReadAllAt (null or a time), readIds (the
    // announcements opened one by one, at most 200), updatedAt }. Only the user reads and
    // writes it; it holds announcement IDs only (no message text, nothing about others).
    match /users/{userId}/inboxState/{stateId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && stateId == 'announcements'
        && request.resource.data.keys().hasOnly(['lastReadAllAt', 'readIds', 'updatedAt'])
        && request.resource.data.readIds is list
        && request.resource.data.readIds.size() <= 200
        && (request.resource.data.get('lastReadAllAt', null) == null
          || request.resource.data.lastReadAllAt is timestamp)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ─── Complaints ────────────────────────────────────────────────────────
    // complaints/{bookingId}_{reporterUid}: "Report a problem" on a booking, by its passenger
    // or its assigned driver; the fixed ID allows one report per booking per person.
    // { bookingId, reporterId, reporterRole, reportedUserId, category, message, status,
    // createdAt, updatedAt } on create. reportedUserId is the other side of the booking (the
    // driver when a passenger reports, the passenger when a driver reports), or null when the
    // booking has no driver (a passenger reporting a request nobody accepted); never the
    // reporter. Complaints from before 2026-11-10 have no reportedUserId. Admins later set
    // status (open / in_review / resolved), adminNotes and updatedBy, and on resolving an
    // outcome (no_action / warned / suspended) with resolvedAt and resolvedBy. The reporter can read
    // their own report (the ID ends in their uid, so a missing report can be checked too);
    // only admins list. Nobody deletes.
    // Independent of the booking and out-of-area rules (it only reads bookings/{id}).

    // ─── Warnings (admin → user, counted; the admin decides any suspension) ───
    //
    // warnings/{warningId}: the ID is the complaint's ID when the warning comes from a
    // complaint (so one warning per complaint: a second create is an update and refused).
    // Admins create and may only withdraw; the warned user reads their own and sets
    // acknowledgedAt once ("I understand"). In the commit that anonymizes the user, an admin
    // clears the reason (the record stays). Nobody deletes.
    match /warnings/{warningId} {
      function isValidWarningCreate() {
        let data = request.resource.data;
        let keys = ['userId', 'role', 'complaintId', 'bookingId', 'reason', 'adminId', 'createdAt', 'status', 'acknowledgedAt'];
        return isAdmin()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.userId is string
          && data.userId.size() > 0
          && data.role in ['driver', 'passenger']
          && data.reason is string
          && data.reason.trim().size() > 0
          && data.reason.size() <= 500
          && data.adminId == request.auth.uid
          && data.createdAt == request.time
          && data.status == 'active'
          && data.acknowledgedAt == null
          && (
            (data.complaintId == null && data.bookingId == null)
            || (data.complaintId is string && isFromComplaint(data))
          );
      }

      // The complaint names this user as the reported side, in this role, on this booking.
      function isFromComplaint(data) {
        let complaint = get(/databases/$(database)/documents/complaints/$(data.complaintId)).data;
        return warningId == data.complaintId
          && complaint.get('reportedUserId', null) == data.userId
          && complaint.bookingId == data.bookingId
          && ((complaint.reporterRole == 'passenger' && data.role == 'driver')
            || (complaint.reporterRole == 'driver' && data.role == 'passenger'));
      }

      function isAcknowledge() {
        return isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'active'
          && resource.data.acknowledgedAt == null
          && onlyChanged(['acknowledgedAt'])
          && request.resource.data.acknowledgedAt == request.time;
      }

      function isWithdraw() {
        let data = request.resource.data;
        return isAdmin()
          && resource.data.status == 'active'
          && onlyChanged(['status', 'withdrawnAt', 'withdrawnBy'])
          && data.status == 'withdrawn'
          && data.withdrawnAt == request.time
          && data.withdrawnBy == request.auth.uid;
      }

      // Account deletion: the reason is cleared in the commit that anonymizes users/{uid}.
      function isReasonCleared() {
        let data = request.resource.data;
        return isAdmin()
          && onlyChanged(['reason', 'reasonClearedAt'])
          && data.reason == ''
          && data.reasonClearedAt == request.time
          && isAnonymizedInThisCommit(userPath(resource.data.userId));
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidWarningCreate();
      allow update: if isAcknowledge() || isWithdraw() || isReasonCleared();
      allow delete: if false;
    }

    match /complaints/{complaintId} {
      function isValidComplaintCreate() {
        let data = request.resource.data;
        let keys = ['bookingId', 'reporterId', 'reporterRole', 'reportedUserId', 'category', 'message', 'status', 'createdAt', 'updatedAt'];
        let booking = get(bookingPath(data.bookingId)).data;
        return isSignedIn()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.reporterId == request.auth.uid
          && data.bookingId is string
          && data.bookingId.matches('[^_/]+')
          && complaintId == data.bookingId + '_' + request.auth.uid
          && exists(bookingPath(data.bookingId))
          && isOwnBookingAs(booking, data.reporterRole)
          && isReportedPartyOf(booking, data.reporterRole, data.reportedUserId)
          && data.category in ['driver_behavior', 'passenger_behavior', 'fare_or_payment', 'safety', 'lost_item', 'app_problem', 'other']
          && !(data.reporterRole == 'passenger' && data.category == 'passenger_behavior')
          && !(data.reporterRole == 'driver' && data.category == 'driver_behavior')
          && data.message is string
          && data.message.trim().size() > 0
          && data.message.size() <= 1000
          && data.status == 'open'
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      function isOwnBookingAs(booking, role) {
        return (role == 'passenger' && booking.passengerId == request.auth.uid)
          || (role == 'driver' && booking.driverId == request.auth.uid);
      }

      // The other side of the booking; null only when that side is empty (no driver yet).
      function isReportedPartyOf(booking, role, reported) {
        let other = role == 'passenger' ? booking.get('driverId', null) : booking.get('passengerId', null);
        return reported == other
          && (reported == null || (reported is string && reported != request.auth.uid));
      }

      function isValidComplaintReview() {
        let data = request.resource.data;
        return isAdmin()
          && onlyChanged(['status', 'adminNotes', 'updatedAt', 'updatedBy', 'outcome', 'resolvedAt', 'resolvedBy'])
          && data.status in ['open', 'in_review', 'resolved']
          && data.adminNotes is string
          && data.adminNotes.size() <= 1000
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid
          && isValidOutcome(data);
      }

      // Resolving records an outcome and who resolved it, now: 'no_action'; 'warned' (this
      // complaint's warning, warnings/{complaintId}, exists after the commit); or 'suspended'
      // (the reported driver's admin suspension is set in this same commit; only for a
      // complaint by a passenger that stores reportedUserId). Saving a note on an already
      // resolved complaint (also one from before outcomes existed) leaves these untouched.
      // Any other status has no outcome, so reopening clears it.
      function isValidOutcome(data) {
        return data.status == 'resolved'
          ? (
            (
              resource.data.status == 'resolved'
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['outcome', 'resolvedAt', 'resolvedBy'])
            )
            || (
              data.resolvedAt == request.time
              && data.resolvedBy == request.auth.uid
              && (
                data.outcome == 'no_action'
                || (
                  data.outcome == 'warned'
                  && existsAfter(/databases/$(database)/documents/warnings/$(complaintId))
                )
                || (
                  data.outcome == 'suspended'
                  && resource.data.reporterRole == 'passenger'
                  && resource.data.get('reportedUserId', null) is string
                  && getAfter(driverPath(resource.data.reportedUserId)).data.get('suspendedAt', null) == request.time
                )
              )
            )
          )
          : (
            data.get('outcome', null) == null
            && data.get('resolvedAt', null) == null
            && data.get('resolvedBy', null) == null
          );
      }

      allow get: if isAdmin()
        || (isSignedIn() && complaintId.matches('[^_]+_' + request.auth.uid));
      allow list: if isAdmin();
      allow create: if isValidComplaintCreate();
      allow update: if isValidComplaintReview();
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
