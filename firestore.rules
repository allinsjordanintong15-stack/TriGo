rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPassenger() {
      return isSignedIn() && userDoc().data.role == 'passenger';
    }

    function driverPath(uid) {
      return /databases/$(database)/documents/drivers/$(uid);
    }

    function bookingPath(id) {
      return /databases/$(database)/documents/bookings/$(id);
    }

    function driverDoc() {
      return get(driverPath(request.auth.uid));
    }

    // Driver capability comes from an admin: either a `driver` account, or a passenger
    // whose driver application was approved AND who has an admin-created drivers/{uid}
    // record. Clients can never create drivers/{uid} or approve an application.
    function isDriver() {
      return isSignedIn()
        && (
          userDoc().data.role == 'driver'
          || (
            userDoc().data.role == 'passenger'
            && exists(driverPath(request.auth.uid))
            && exists(/databases/$(database)/documents/driverApplications/$(request.auth.uid))
            && get(/databases/$(database)/documents/driverApplications/$(request.auth.uid)).data.status == 'approved'
          )
        );
    }

    function isValidVehiclePlate(plate) {
      return plate is string && plate.matches('^[A-Z0-9][A-Z0-9 -]{0,10}[A-Z0-9]$');
    }

    // Driver access needs both the `driver` role in users/{uid} and an admin-verified
    // record in drivers/{uid}. Only verified drivers may accept new bookings.
    function isVerifiedDriver() {
      return isDriver()
        && exists(driverPath(request.auth.uid))
        && driverDoc().data.isVerified == true;
    }

    // True when an update changes only the listed fields.
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isValidLocation(loc) {
      return loc.keys().hasAll(['latitude', 'longitude', 'address'])
        && loc.latitude is number
        && loc.longitude is number
        && loc.address is string;
    }

    // ─── Users ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'passenger'
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.mobileNumber is string;

      // Passengers may update their own profile but cannot change role or uid.
      allow update: if isOwner(userId)
        && isPassenger()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.role == 'passenger';
    }

    // ─── Bookings ──────────────────────────────────────────────────────────
    // Ride lifecycle (docs/plans/task2-ride-lifecycle.md):
    //   pending → accepted → arrived → in_progress → completed, or → cancelled.
    // Only the assigned driver moves a ride forward, one step at a time. Completed and
    // cancelled bookings are final. After creation, driverId changes only on accept and
    // finalFare is written only on completion (equal to the agreed/estimated fare); no
    // other fare field can change. Fields older bookings may lack are read with
    // .get(field, default) in update rules. Read rules use plain field access so list
    // queries (open requests, trip history) can be checked against their filters.

    match /bookings/{bookingId} {
      function isValidCancelReason() {
        return request.resource.data.get('cancellationReason', null) == null
          || (
            request.resource.data.cancellationReason is string
            && request.resource.data.cancellationReason.size() <= 200
          );
      }

      // finalFare = agreedFare (out-of-area) when set, otherwise estimatedFare.
      function isExpectedFinalFare() {
        let agreedFare = resource.data.get('agreedFare', null);
        return request.resource.data.finalFare is number
          && (
            (agreedFare == null && request.resource.data.finalFare == resource.data.estimatedFare)
            || (agreedFare != null && request.resource.data.finalFare == agreedFare)
          );
      }

      function isAssignedDriver() {
        return isDriver() && resource.data.get('driverId', null) == request.auth.uid;
      }

      allow read: if isSignedIn()
        && resource.data.passengerId == request.auth.uid;

      // Verified drivers see open standard bookings.
      // Out-of-area bookings are never open: their driver comes from the fare agreement.
      allow read: if isVerifiedDriver()
        && resource.data.status == 'pending'
        && resource.data.driverId == null
        && resource.data.bookingType == 'standard';

      // A driver can always read bookings assigned to them (active trip and trip history),
      // even if their verification is revoked later.
      allow read: if isDriver()
        && resource.data.driverId == request.auth.uid;

      // Passengers create bookings with driverId == null. Driver assignment is a
      // separate, authorized operation (driver app / Cloud Function) and must never
      // be set by the passenger. Extra fields (agreedFare, fareAgreement,
      // outOfAreaRequestId) are permitted but cannot include a forged driverId.
      allow create: if isSignedIn()
        && isPassenger()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.driverId == null
        && request.resource.data.bookingType in ['standard', 'out_of_area']
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && isValidLocation(request.resource.data.pickupLocation)
        && isValidLocation(request.resource.data.destination)
        && request.resource.data.distanceKm is number
        && request.resource.data.estimatedFare is number;

      // T1 accept: a verified driver who is online, available, not on another trip and has
      // the requested vehicle type claims an open standard booking. The same commit must
      // mark the driver unavailable and link drivers/{uid}.currentBookingId to this booking.
      allow update: if isVerifiedDriver()
        && resource.data.get('bookingType', 'standard') == 'standard'
        && resource.data.status == 'pending'
        && resource.data.get('driverId', null) == null
        && resource.data.passengerId != request.auth.uid
        && driverDoc().data.isOnline == true
        && driverDoc().data.isAvailable == true
        && driverDoc().data.get('currentBookingId', null) == null
        && driverDoc().data.vehicleType == resource.data.vehicleType
        && request.resource.data.status == 'accepted'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && onlyChanged(['status', 'driverId', 'acceptedAt', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.isAvailable == false
        && getAfter(driverPath(request.auth.uid)).data.get('currentBookingId', null) == bookingId;

      // T2-T4 and T6: the assigned driver moves the ride forward or cancels before it starts.
      // isDriver() (not isVerifiedDriver) so a driver revoked mid-ride can still finish it.
      allow update: if isAssignedDriver()
        && request.resource.data.updatedAt == request.time
        && (
          // T2 accepted → arrived
          (
            resource.data.status == 'accepted'
            && request.resource.data.status == 'arrived'
            && request.resource.data.arrivedAt == request.time
            && onlyChanged(['status', 'arrivedAt', 'updatedAt'])
          )
          // T3 arrived → in_progress
          || (
            resource.data.status == 'arrived'
            && request.resource.data.status == 'in_progress'
            && request.resource.data.startedAt == request.time
            && onlyChanged(['status', 'startedAt', 'updatedAt'])
          )
          // T4 in_progress → completed (paymentMethod recorded by the driver until Task 4)
          || (
            resource.data.status == 'in_progress'
            && request.resource.data.status == 'completed'
            && request.resource.data.completedAt == request.time
            && request.resource.data.paymentMethod in ['cash', 'gcash']
            && isExpectedFinalFare()
            && onlyChanged(['status', 'completedAt', 'finalFare', 'paymentMethod', 'updatedAt'])
          )
          // T6 driver cancels before the ride starts
          || (
            resource.data.status in ['accepted', 'arrived']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'driver'
            && request.resource.data.cancelledAt == request.time
            && isValidCancelReason()
            && onlyChanged(['status', 'cancelledBy', 'cancellationReason', 'cancelledAt', 'updatedAt'])
          )
        );

      // T5 passenger cancels before the ride starts.
      allow update: if isPassenger()
        && resource.data.passengerId == request.auth.uid
        && resource.data.status in ['pending', 'accepted', 'arrived']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'passenger'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidCancelReason()
        && onlyChanged(['status', 'cancelledBy', 'cancellationReason', 'cancelledAt', 'updatedAt']);
    }

    // ─── Out-of-area requests ──────────────────────────────────────────────

    match /outOfAreaRequests/{requestId} {
      allow read: if isSignedIn()
        && resource.data.passengerId == request.auth.uid;

      // Verified drivers can review open requests and the ones they are handling.
      allow read: if isVerifiedDriver()
        && (resource.data.status == 'searching' || resource.data.driverId == request.auth.uid);

      // Verified driver accepts an open, unexpired request and proposes a fare
      // (see fareAgreementService.createProposal). The passenger still has to agree.
      allow update: if isVerifiedDriver()
        && resource.data.status == 'searching'
        && resource.data.driverId == null
        && resource.data.passengerId != request.auth.uid
        && (resource.data.expiresAt == null || request.time < resource.data.expiresAt)
        && request.resource.data.status == 'negotiating'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.fareAgreement.driverProposedFare is number
        && request.resource.data.fareAgreement.driverProposedFare > 0
        && request.resource.data.fareAgreement.agreedFare == request.resource.data.fareAgreement.driverProposedFare
        && request.resource.data.fareAgreement.standardEstimatedFare == resource.data.standardEstimatedFare
        && request.resource.data.fareAgreement.agreedByDriver == true
        && request.resource.data.fareAgreement.agreedByPassenger == false
        && request.resource.data.suggestedAgreementFare == request.resource.data.fareAgreement.driverProposedFare
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt']);

      // The driver handling a request may withdraw before the passenger agrees,
      // returning it to the open pool. Declining an open request needs no write.
      allow update: if isVerifiedDriver()
        && resource.data.driverId == request.auth.uid
        && resource.data.status in ['negotiating', 'driver_interested']
        && request.resource.data.status == 'searching'
        && request.resource.data.driverId == null
        && request.resource.data.suggestedAgreementFare == null
        && request.resource.data.fareAgreement == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt']);

      // Passenger opens a request (bookingService.createOutOfAreaRequest): exactly these
      // fields, no driver or fare agreement yet, server timestamps, and an expiry within
      // 35 min (30 min request setting + 5 min client clock-skew grace).
      allow create: if isSignedIn()
        && isPassenger()
        && request.resource.data.keys().hasAll([
          'passengerId', 'pickupLocation', 'destination', 'vehicleType', 'distanceKm',
          'standardEstimatedFare', 'suggestedAgreementFare', 'agreedFare', 'status',
          'driverId', 'fareAgreement', 'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'passengerId', 'pickupLocation', 'destination', 'vehicleType', 'distanceKm',
          'standardEstimatedFare', 'suggestedAgreementFare', 'agreedFare', 'status',
          'driverId', 'fareAgreement', 'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.driverId == null
        && request.resource.data.suggestedAgreementFare == null
        && request.resource.data.agreedFare == null
        && request.resource.data.fareAgreement == null
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && isValidLocation(request.resource.data.pickupLocation)
        && isValidLocation(request.resource.data.destination)
        && request.resource.data.distanceKm is number
        && request.resource.data.distanceKm > 0
        && request.resource.data.standardEstimatedFare is number
        && request.resource.data.standardEstimatedFare > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(35, 'm');

      allow update: if isSignedIn()
        && isPassenger()
        && resource.data.passengerId == request.auth.uid
        && (
          // Passenger cancels the request while it is still open
          (
            resource.data.status in ['searching', 'driver_interested', 'negotiating']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          )
          // Passenger accepts a fare proposal.
          // The driver-side fields (driverId, driverProposedFare, agreedByDriver)
          // are authored by an authorized flow (driver app / Cloud Function) and must
          // NOT be altered by the passenger. The agreed fare must equal the driver's
          // proposed fare, so a passenger cannot fabricate a different fare or a
          // driver agreement that does not exist.
          || (
            resource.data.status in ['negotiating', 'driver_interested']
            && request.resource.data.status == 'accepted'
            && request.resource.data.agreedFare is number
            && request.resource.data.agreedFare == request.resource.data.fareAgreement.driverProposedFare
            && request.resource.data.fareAgreement.agreedByPassenger == true
            && request.resource.data.fareAgreement.standardEstimatedFare == resource.data.fareAgreement.standardEstimatedFare
            && request.resource.data.fareAgreement.driverProposedFare == resource.data.fareAgreement.driverProposedFare
            && request.resource.data.fareAgreement.agreedByDriver == resource.data.fareAgreement.agreedByDriver
            && request.resource.data.driverId == resource.data.driverId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'agreedFare', 'fareAgreement', 'updatedAt'])
          )
          // Passenger declines a pending fare proposal
          || (
            resource.data.status in ['negotiating', 'driver_interested']
            && request.resource.data.status == 'searching'
            && request.resource.data.driverId == null
            && request.resource.data.fareAgreement == null
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt'])
          )
        );
    }

    // ─── Ratings ───────────────────────────────────────────────────────────

    match /ratings/{ratingId} {
      allow read: if isSignedIn()
        && resource.data.passengerId == request.auth.uid;

      allow create: if isSignedIn()
        && isPassenger()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.bookingId is string
        && request.resource.data.driverId is string;
    }

    // ─── Notifications ─────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ─── Drivers (read-only for passengers during driver search) ───────────

    match /drivers/{driverId} {
      // currentBookingId may only be set in the commit that accepts that booking, and only
      // cleared once that booking is completed or cancelled. Unchanged is always fine.
      function isValidCurrentBookingChange() {
        let before = resource.data.get('currentBookingId', null);
        let after = request.resource.data.get('currentBookingId', null);
        return before == after
          || (
            before == null
            && after is string
            && get(bookingPath(after)).data.status == 'pending'
            && getAfter(bookingPath(after)).data.status == 'accepted'
            && getAfter(bookingPath(after)).data.driverId == request.auth.uid
          )
          || (
            before != null
            && after == null
            && getAfter(bookingPath(before)).data.status in ['completed', 'cancelled']
          );
      }

      allow read: if isSignedIn()
        && resource.data.isVerified == true;

      // A driver can always read their own record, including while pending verification.
      allow read: if isOwner(driverId);

      // A driver controls only their own duty status, position and current-trip link.
      // Admin-managed fields (isVerified, name, vehicle, rating) cannot be changed from the
      // app. Being available requires being online, an unverified driver can only be
      // offline, and a driver linked to a booking is never available.
      allow update: if isOwner(driverId)
        && isDriver()
        && onlyChanged(['isOnline', 'isAvailable', 'currentLocation', 'currentBookingId', 'updatedAt'])
        && request.resource.data.isOnline is bool
        && request.resource.data.isAvailable is bool
        && (!request.resource.data.isAvailable || request.resource.data.isOnline)
        && (
          (!request.resource.data.isOnline && !request.resource.data.isAvailable)
          || resource.data.isVerified == true
        )
        && (
          !('currentLocation' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            request.resource.data.currentLocation.latitude is number
            && request.resource.data.currentLocation.longitude is number
          )
        )
        && (
          request.resource.data.get('currentBookingId', null) == null
          || request.resource.data.isAvailable == false
        )
        && isValidCurrentBookingChange();

      // Driver records are created and removed by TriGo admins only.
      allow create, delete: if false;
    }

    // ─── Driver applications ───────────────────────────────────────────────
    // One application per passenger at driverApplications/{uid}. Passengers can only
    // submit (always `pending`) or resubmit after a rejection. Approval, rejection,
    // adminRemarks and reviewedAt are set by administrators only (console / Admin
    // Website), so a passenger can never approve themselves.

    match /driverApplications/{uid} {
      function isValidPersonName(name) {
        return name is string && name.size() >= 1 && name.size() <= 50;
      }

      // A document entry must reference this applicant's own file in Cloud Storage.
      function isValidApplicationDocument(entry, documentType) {
        return entry is map
          && entry.keys().hasAll(['storagePath', 'downloadUrl', 'fileName', 'contentType', 'uploadedAt'])
          && entry.keys().hasOnly(['storagePath', 'downloadUrl', 'fileName', 'contentType', 'uploadedAt'])
          && entry.storagePath == 'driverApplications/' + uid + '/' + documentType
          && entry.downloadUrl is string
          && entry.downloadUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*')
          && entry.fileName is string
          && entry.fileName.size() <= 200
          && entry.contentType is string
          && entry.contentType.matches('^image/.*')
          && (entry.uploadedAt == null || entry.uploadedAt is timestamp);
      }

      // Both required documents (OR/CR and LTO driver's license), nothing else.
      function hasValidDocuments(data) {
        return data.documents is map
          && data.documents.keys().hasAll(['orCr', 'ltoLicense'])
          && data.documents.keys().hasOnly(['orCr', 'ltoLicense'])
          && isValidApplicationDocument(data.documents.orCr, 'orCr')
          && isValidApplicationDocument(data.documents.ltoLicense, 'ltoLicense');
      }

      // Applicant details: structured name, the account's own email and mobile number.
      function hasValidApplicantDetails(data) {
        return isValidPersonName(data.firstName)
          && (data.middleName == null || isValidPersonName(data.middleName))
          && isValidPersonName(data.lastName)
          && data.fullName is string
          && data.fullName.size() <= 160
          && data.email == request.auth.token.email
          && data.mobileNumber == userDoc().data.mobileNumber
          && data.vehicleType in ['tricycle', 'motorcycle']
          && isValidVehiclePlate(data.vehiclePlate)
          && hasValidDocuments(data);
      }

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && isPassenger()
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'middleName', 'lastName', 'fullName', 'email', 'mobileNumber',
          'vehicleType', 'vehiclePlate', 'documents',
          'status', 'adminRemarks', 'submittedAt', 'updatedAt', 'reviewedAt'
        ])
        && request.resource.data.uid == uid
        && hasValidApplicantDetails(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.adminRemarks == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Controlled resubmission: only after an administrator rejected the application.
      // uid, adminRemarks and reviewedAt cannot change.
      allow update: if isOwner(uid)
        && isPassenger()
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'middleName', 'lastName', 'fullName', 'email', 'mobileNumber',
          'vehicleType', 'vehiclePlate', 'documents', 'status', 'submittedAt', 'updatedAt'
        ])
        && hasValidApplicantDetails(request.resource.data)
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ─── Fare settings (read-only for app; admin manages via console) ──────

    match /fareSettings/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
