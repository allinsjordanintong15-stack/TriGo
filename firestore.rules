rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins carry the `admin: true` custom claim on their ID token, set only with the
    // Admin SDK (scripts/setAdminClaim.mjs). It is not stored in users/{uid}, so no client
    // write can grant it.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPassenger() {
      return isSignedIn() && userDoc().data.role == 'passenger';
    }

    function driverPath(uid) {
      return /databases/$(database)/documents/drivers/$(uid);
    }

    function bookingPath(id) {
      return /databases/$(database)/documents/bookings/$(id);
    }

    function requestPath(id) {
      return /databases/$(database)/documents/outOfAreaRequests/$(id);
    }

    function applicationPath(uid) {
      return /databases/$(database)/documents/driverApplications/$(uid);
    }

    function driverDoc() {
      return get(driverPath(request.auth.uid));
    }

    // Driver capability comes from an admin: either a `driver` account, or a passenger
    // whose driver application was approved AND who has an admin-created drivers/{uid}
    // record. Clients can never create drivers/{uid} or approve an application.
    function isDriver() {
      return isSignedIn()
        && (
          userDoc().data.role == 'driver'
          || (
            userDoc().data.role == 'passenger'
            && exists(driverPath(request.auth.uid))
            && exists(/databases/$(database)/documents/driverApplications/$(request.auth.uid))
            && get(/databases/$(database)/documents/driverApplications/$(request.auth.uid)).data.status == 'approved'
          )
        );
    }

    function isValidVehiclePlate(plate) {
      return plate is string && plate.matches('^[A-Z0-9][A-Z0-9 -]{0,10}[A-Z0-9]$');
    }

    // Driver access needs both the `driver` role in users/{uid} and an admin-verified
    // record in drivers/{uid}. Only verified drivers may accept new bookings.
    function isVerifiedDriver() {
      return isDriver()
        && exists(driverPath(request.auth.uid))
        && driverDoc().data.isVerified == true;
    }

    // True when an update changes only the listed fields.
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // At most 2 decimal places (centavos). Compared with a tolerance because e.g.
    // 8.15 * 100 is not exactly 815 in floating point.
    function hasAtMostTwoDecimals(value) {
      return math.abs(value * 100 - math.round(value * 100)) < 0.000001;
    }

    function isValidLocation(loc) {
      return loc.keys().hasAll(['latitude', 'longitude', 'address'])
        && loc.latitude is number
        && loc.longitude is number
        && loc.address is string;
    }

    // ─── Users ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Admins read any profile (user management on the admin website); writes unchanged.
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'passenger'
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.mobileNumber is string;

      // Passengers may update their own profile but cannot change role or uid.
      allow update: if isOwner(userId)
        && isPassenger()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.role == 'passenger';
    }

    // ─── Contacts ──────────────────────────────────────────────────────────
    // contacts/{uid}: the user's name and mobile number, kept equal to users/{uid} by its
    // owner. Readable by the other party of an active trip only: the driver assigned to the
    // passenger's booking, and that booking's passenger. "Assigned and active" comes from
    // drivers/{driverUid}.currentBookingId (set on accept/claim, cleared when the trip ends)
    // plus the booking's status, so a cancelled trip stops sharing at once.

    match /contacts/{uid} {
      function currentBookingOf(driverUid) {
        return get(bookingPath(get(driverPath(driverUid)).data.currentBookingId)).data;
      }

      function hasCurrentBooking(driverUid) {
        return exists(driverPath(driverUid))
          && get(driverPath(driverUid)).data.get('currentBookingId', null) is string;
      }

      function isActiveTripBetween(passengerUid, driverUid) {
        return hasCurrentBooking(driverUid)
          && currentBookingOf(driverUid).passengerId == passengerUid
          && currentBookingOf(driverUid).driverId == driverUid
          && currentBookingOf(driverUid).status in ['accepted', 'arrived', 'in_progress'];
      }

      allow read: if isOwner(uid);

      // The assigned driver reads their current passenger's card.
      allow read: if isDriver()
        && isActiveTripBetween(uid, request.auth.uid);

      // A passenger reads the card of the driver assigned to their active booking.
      allow read: if isSignedIn()
        && isActiveTripBetween(request.auth.uid, uid);

      // getAfter, so a profile edit can update users/{uid} and this card in one batch.
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['fullName', 'mobileNumber', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.mobileNumber is string
        && request.resource.data.fullName
          == getAfter(/databases/$(database)/documents/users/$(uid)).data.fullName
        && request.resource.data.mobileNumber
          == getAfter(/databases/$(database)/documents/users/$(uid)).data.mobileNumber
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ─── Bookings ──────────────────────────────────────────────────────────
    // Ride lifecycle (docs/plans/task2-ride-lifecycle.md):
    //   pending → accepted → arrived → in_progress → completed, or → cancelled.
    // Only the assigned driver moves a ride forward, one step at a time. Completed and
    // cancelled bookings are final. After creation, driverId changes only on accept and
    // finalFare is written only on completion (equal to the agreed/estimated fare); no
    // other fare field can change. Fields older bookings may lack are read with
    // .get(field, default) in update rules. Read rules use plain field access so list
    // queries (open requests, trip history) can be checked against their filters.

    match /bookings/{bookingId} {
      function isValidCancelReason() {
        return request.resource.data.get('cancellationReason', null) == null
          || (
            request.resource.data.cancellationReason is string
            && request.resource.data.cancellationReason.size() <= 200
          );
      }

      // finalFare = agreedFare (out-of-area) when set, otherwise estimatedFare.
      function isExpectedFinalFare() {
        let agreedFare = resource.data.get('agreedFare', null);
        return request.resource.data.finalFare is number
          && (
            (agreedFare == null && request.resource.data.finalFare == resource.data.estimatedFare)
            || (agreedFare != null && request.resource.data.finalFare == agreedFare)
          );
      }

      function isAssignedDriver() {
        return isDriver() && resource.data.get('driverId', null) == request.auth.uid;
      }

      // Admins read every booking (Admin Website: passenger history, drivers, reports).
      // Read-only: no admin write rule exists for bookings.
      allow read: if isAdmin();

      allow read: if isSignedIn()
        && resource.data.passengerId == request.auth.uid;

      // Verified drivers see open standard bookings.
      // Out-of-area bookings are never open: their driver comes from the fare agreement.
      allow read: if isVerifiedDriver()
        && resource.data.status == 'pending'
        && resource.data.driverId == null
        && resource.data.bookingType == 'standard';

      // A driver can always read bookings assigned to them (active trip and trip history),
      // even if their verification is revoked later.
      allow read: if isDriver()
        && resource.data.driverId == request.auth.uid;

      // The driver agreed on an out-of-area request can read its booking (bookings/{requestId})
      // before claiming it, and see if the passenger cancelled it.
      allow read: if isVerifiedDriver()
        && resource.data.bookingType == 'out_of_area'
        && get(requestPath(bookingId)).data.driverId == request.auth.uid;

      // Out-of-area create (bookingService.acceptProposalAndCreateBooking): the passenger
      // creates bookings/{requestId} in the same commit that accepts the driver's fare on
      // their open, unexpired request. Trip details and fares are copied from the request
      // and the fare agreement equals the one stored on the accepted request. The booking
      // stays unassigned; the agreed driver (request.driverId) claims it separately.
      function isValidOutOfAreaBookingCreate() {
        let data = request.resource.data;
        let req = get(requestPath(bookingId)).data;
        let reqAfter = getAfter(requestPath(bookingId)).data;
        return data.keys().hasOnly([
            'passengerId', 'driverId', 'vehicleType', 'bookingType', 'pickupLocation',
            'destination', 'distanceKm', 'estimatedFare', 'driverProposedFare', 'agreedFare',
            'fareAgreement', 'finalFare', 'status', 'outOfAreaRequestId', 'createdAt',
            'updatedAt', 'acceptedAt', 'arrivedAt', 'startedAt', 'completedAt', 'cancelledAt',
            'paymentMethod', 'cancelledBy', 'cancellationReason'
          ])
          && data.passengerId == request.auth.uid
          && data.bookingType == 'out_of_area'
          && data.status == 'pending'
          && data.driverId == null
          && data.outOfAreaRequestId == bookingId
          && req.passengerId == request.auth.uid
          && req.status == 'negotiating'
          && req.driverId is string
          && req.expiresAt is timestamp
          && request.time < req.expiresAt
          && reqAfter.status == 'accepted'
          && data.vehicleType == req.vehicleType
          && data.pickupLocation == req.pickupLocation
          && data.destination == req.destination
          && data.distanceKm == req.distanceKm
          && data.estimatedFare == req.standardEstimatedFare
          && data.driverProposedFare == req.fareAgreement.driverProposedFare
          && data.agreedFare == req.fareAgreement.driverProposedFare
          && data.fareAgreement == reqAfter.fareAgreement
          && data.finalFare == null
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.get('acceptedAt', null) == null
          && data.get('arrivedAt', null) == null
          && data.get('startedAt', null) == null
          && data.get('completedAt', null) == null
          && data.get('cancelledAt', null) == null
          && data.get('paymentMethod', null) == null
          && data.get('cancelledBy', null) == null
          && data.get('cancellationReason', null) == null;
      }

      // Passengers create standard bookings with driverId == null. Driver assignment is a
      // separate, authorized operation (driver app) and must never be set by the passenger.
      allow create: if isSignedIn()
        && isPassenger()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.driverId == null
        && request.resource.data.bookingType == 'standard'
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && isValidLocation(request.resource.data.pickupLocation)
        && isValidLocation(request.resource.data.destination)
        && request.resource.data.distanceKm is number
        && request.resource.data.estimatedFare is number;

      allow create: if isSignedIn()
        && isPassenger()
        && isValidOutOfAreaBookingCreate();

      // T1 accept: a verified driver who is online, available, not on another trip, not
      // reserved by an out-of-area proposal and has the requested vehicle type claims an
      // open standard booking. The same commit must mark the driver unavailable and link
      // drivers/{uid}.currentBookingId to this booking.
      allow update: if isVerifiedDriver()
        && resource.data.get('bookingType', 'standard') == 'standard'
        && resource.data.status == 'pending'
        && resource.data.get('driverId', null) == null
        && resource.data.passengerId != request.auth.uid
        && driverDoc().data.isOnline == true
        && driverDoc().data.isAvailable == true
        && driverDoc().data.get('currentBookingId', null) == null
        && driverDoc().data.get('currentRequestId', null) == null
        && driverDoc().data.vehicleType == resource.data.vehicleType
        && request.resource.data.status == 'accepted'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && onlyChanged(['status', 'driverId', 'acceptedAt', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.isAvailable == false
        && getAfter(driverPath(request.auth.uid)).data.get('currentBookingId', null) == bookingId;

      // Out-of-area claim (driverBookingService.claimOutOfAreaBooking): only the driver the
      // passenger agreed with (request.driverId), still reserved for this request and not on
      // another trip, claims the pending booking the passenger created at bookings/{requestId}.
      // The same commit moves the driver's reservation to the booking: currentBookingId set,
      // currentRequestId cleared, not available. A cancelled booking can no longer be claimed.
      allow update: if isVerifiedDriver()
        && resource.data.bookingType == 'out_of_area'
        && resource.data.status == 'pending'
        && resource.data.get('driverId', null) == null
        && resource.data.passengerId != request.auth.uid
        && get(requestPath(bookingId)).data.status == 'accepted'
        && get(requestPath(bookingId)).data.driverId == request.auth.uid
        && driverDoc().data.get('currentRequestId', null) == bookingId
        && driverDoc().data.get('currentBookingId', null) == null
        && driverDoc().data.vehicleType == resource.data.vehicleType
        && request.resource.data.status == 'accepted'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && onlyChanged(['status', 'driverId', 'acceptedAt', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.get('currentBookingId', null) == bookingId
        && getAfter(driverPath(request.auth.uid)).data.get('currentRequestId', null) == null
        && getAfter(driverPath(request.auth.uid)).data.isAvailable == false;

      // T2-T4 and T6: the assigned driver moves the ride forward or cancels before it starts.
      // isDriver() (not isVerifiedDriver) so a driver revoked mid-ride can still finish it.
      allow update: if isAssignedDriver()
        && request.resource.data.updatedAt == request.time
        && (
          // T2 accepted → arrived
          (
            resource.data.status == 'accepted'
            && request.resource.data.status == 'arrived'
            && request.resource.data.arrivedAt == request.time
            && onlyChanged(['status', 'arrivedAt', 'updatedAt'])
          )
          // T3 arrived → in_progress
          || (
            resource.data.status == 'arrived'
            && request.resource.data.status == 'in_progress'
            && request.resource.data.startedAt == request.time
            && onlyChanged(['status', 'startedAt', 'updatedAt'])
          )
          // T4 in_progress → completed (paymentMethod recorded by the driver until Task 4)
          || (
            resource.data.status == 'in_progress'
            && request.resource.data.status == 'completed'
            && request.resource.data.completedAt == request.time
            && request.resource.data.paymentMethod in ['cash', 'gcash']
            && isExpectedFinalFare()
            && onlyChanged(['status', 'completedAt', 'finalFare', 'paymentMethod', 'updatedAt'])
          )
          // T6 driver cancels before the ride starts
          || (
            resource.data.status in ['accepted', 'arrived']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'driver'
            && request.resource.data.cancelledAt == request.time
            && isValidCancelReason()
            && onlyChanged(['status', 'cancelledBy', 'cancellationReason', 'cancelledAt', 'updatedAt'])
          )
        );

      // T5 passenger cancels before the ride starts.
      allow update: if isPassenger()
        && resource.data.passengerId == request.auth.uid
        && resource.data.status in ['pending', 'accepted', 'arrived']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'passenger'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidCancelReason()
        && onlyChanged(['status', 'cancelledBy', 'cancellationReason', 'cancelledAt', 'updatedAt']);
    }

    // ─── Out-of-area requests ──────────────────────────────────────────────

    match /outOfAreaRequests/{requestId} {
      // Requests without expiresAt (created before expiry was required) count as expired.
      function isUnexpired() {
        return resource.data.expiresAt is timestamp
          && request.time < resource.data.expiresAt;
      }

      // Admins read every request (Admin Website: Out-of-Area Trips page).
      // Read-only: no admin write rule exists for out-of-area requests.
      allow read: if isAdmin();

      allow read: if isSignedIn()
        && resource.data.passengerId == request.auth.uid;

      // Verified drivers see open requests for their own vehicle type
      // (driverService.subscribeToOpenOutOfAreaRequests filters on status and vehicleType).
      allow read: if isVerifiedDriver()
        && resource.data.status == 'searching'
        && resource.data.vehicleType == driverDoc().data.vehicleType;

      // A verified driver can always read the requests they are handling.
      allow read: if isVerifiedDriver()
        && resource.data.driverId == request.auth.uid;

      // Propose (fareAgreementService.createProposal): a verified driver who is online,
      // available, not on a trip, not already reserved and has the requested vehicle type
      // accepts an open, unexpired request. The fare is locked to the request's admin
      // per-km fare (standardEstimatedFare); drivers no longer choose an amount. The same
      // commit must reserve the driver (drivers/{uid}.currentRequestId = this request, not
      // available). The passenger still has to confirm.
      allow update: if isVerifiedDriver()
        && resource.data.status == 'searching'
        && resource.data.driverId == null
        && resource.data.passengerId != request.auth.uid
        && isUnexpired()
        && driverDoc().data.isOnline == true
        && driverDoc().data.isAvailable == true
        && driverDoc().data.get('currentBookingId', null) == null
        && driverDoc().data.get('currentRequestId', null) == null
        && driverDoc().data.vehicleType == resource.data.vehicleType
        && request.resource.data.status == 'negotiating'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.fareAgreement is map
        && request.resource.data.fareAgreement.keys().hasAll([
          'standardEstimatedFare', 'driverProposedFare', 'agreedFare',
          'agreedByPassenger', 'agreedByDriver', 'agreedAt'
        ])
        && request.resource.data.fareAgreement.keys().hasOnly([
          'standardEstimatedFare', 'driverProposedFare', 'agreedFare',
          'agreedByPassenger', 'agreedByDriver', 'agreedAt'
        ])
        && request.resource.data.fareAgreement.driverProposedFare is number
        && request.resource.data.fareAgreement.driverProposedFare == resource.data.standardEstimatedFare
        && request.resource.data.fareAgreement.agreedFare == request.resource.data.fareAgreement.driverProposedFare
        && request.resource.data.fareAgreement.standardEstimatedFare == resource.data.standardEstimatedFare
        && request.resource.data.fareAgreement.agreedByDriver == true
        && request.resource.data.fareAgreement.agreedByPassenger == false
        && request.resource.data.fareAgreement.agreedAt == null
        && request.resource.data.suggestedAgreementFare == request.resource.data.fareAgreement.driverProposedFare
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.get('currentRequestId', null) == requestId
        && getAfter(driverPath(request.auth.uid)).data.isAvailable == false;

      // Withdraw (fareAgreementService.withdrawProposal): the driver handling a request
      // returns it to the open pool before the passenger agrees and releases their own
      // reservation in the same commit. Allowed after expiry too, so a driver is never
      // stuck. Declining an open request needs no write.
      allow update: if isVerifiedDriver()
        && resource.data.driverId == request.auth.uid
        && resource.data.status in ['negotiating', 'driver_interested']
        && request.resource.data.status == 'searching'
        && request.resource.data.driverId == null
        && request.resource.data.suggestedAgreementFare == null
        && request.resource.data.fareAgreement == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt'])
        && getAfter(driverPath(request.auth.uid)).data.get('currentRequestId', null) == null;

      // Passenger opens a request (bookingService.createOutOfAreaRequest): exactly these
      // fields, no driver or fare agreement yet, server timestamps, and an expiry within
      // 35 min (30 min request setting + 5 min client clock-skew grace).
      allow create: if isSignedIn()
        && isPassenger()
        && request.resource.data.keys().hasAll([
          'passengerId', 'pickupLocation', 'destination', 'vehicleType', 'distanceKm',
          'standardEstimatedFare', 'suggestedAgreementFare', 'agreedFare', 'status',
          'driverId', 'fareAgreement', 'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'passengerId', 'pickupLocation', 'destination', 'vehicleType', 'distanceKm',
          'standardEstimatedFare', 'suggestedAgreementFare', 'agreedFare', 'status',
          'driverId', 'fareAgreement', 'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.driverId == null
        && request.resource.data.suggestedAgreementFare == null
        && request.resource.data.agreedFare == null
        && request.resource.data.fareAgreement == null
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && isValidLocation(request.resource.data.pickupLocation)
        && isValidLocation(request.resource.data.destination)
        && request.resource.data.distanceKm is number
        && request.resource.data.distanceKm > 0
        && request.resource.data.standardEstimatedFare is number
        && request.resource.data.standardEstimatedFare > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(35, 'm');

      allow update: if isSignedIn()
        && isPassenger()
        && resource.data.passengerId == request.auth.uid
        && (
          // Passenger cancels the request while it is still open
          (
            resource.data.status in ['searching', 'driver_interested', 'negotiating']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          )
          // Passenger accepts the driver's fare (bookingService.acceptProposalAndCreateBooking)
          // before the request expires, creating bookings/{requestId} in the same commit
          // (validated by the bookings create rule). The driver-side fields (driverId,
          // driverProposedFare, agreedByDriver) cannot change and the agreed fare must equal
          // the driver's proposed fare, so a passenger cannot fabricate a different fare or
          // a driver agreement that does not exist.
          || (
            resource.data.status in ['negotiating', 'driver_interested']
            && isUnexpired()
            // The driver must still be verified: an admin may have revoked them after they
            // accepted the request, and a revoked driver could never claim the booking.
            && get(driverPath(resource.data.driverId)).data.get('isVerified', false) == true
            && request.resource.data.status == 'accepted'
            && request.resource.data.agreedFare is number
            && request.resource.data.agreedFare == resource.data.fareAgreement.driverProposedFare
            && request.resource.data.fareAgreement.keys().hasOnly([
              'standardEstimatedFare', 'driverProposedFare', 'agreedFare',
              'agreedByPassenger', 'agreedByDriver', 'agreedAt'
            ])
            && request.resource.data.fareAgreement.agreedFare == resource.data.fareAgreement.driverProposedFare
            && request.resource.data.fareAgreement.agreedByPassenger == true
            && request.resource.data.fareAgreement.agreedAt == request.time
            && request.resource.data.fareAgreement.standardEstimatedFare == resource.data.fareAgreement.standardEstimatedFare
            && request.resource.data.fareAgreement.driverProposedFare == resource.data.fareAgreement.driverProposedFare
            && request.resource.data.fareAgreement.agreedByDriver == resource.data.fareAgreement.agreedByDriver
            && request.resource.data.driverId == resource.data.driverId
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'agreedFare', 'fareAgreement', 'updatedAt'])
            // Created in this commit as the out-of-area booking (not a standard one, which
            // its own create rule would also allow at this id).
            && !exists(bookingPath(requestId))
            && existsAfter(bookingPath(requestId))
            && getAfter(bookingPath(requestId)).data.bookingType == 'out_of_area'
          )
          // Passenger cancels the pending out-of-area booking before the driver claims it
          // (bookingService.cancelBooking): the request is closed in the same commit that
          // cancels bookings/{requestId}, which must still be unclaimed (pending).
          || (
            resource.data.status == 'accepted'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
            && get(bookingPath(requestId)).data.status == 'pending'
            && getAfter(bookingPath(requestId)).data.status == 'cancelled'
          )
          // Passenger declines a pending fare proposal
          || (
            resource.data.status in ['negotiating', 'driver_interested']
            && request.resource.data.status == 'searching'
            && request.resource.data.driverId == null
            && request.resource.data.fareAgreement == null
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'driverId', 'suggestedAgreementFare', 'fareAgreement', 'updatedAt'])
          )
        );
    }

    // ─── Ratings ───────────────────────────────────────────────────────────

    match /ratings/{ratingId} {
      allow read: if isSignedIn()
        && resource.data.passengerId == request.auth.uid;

      allow create: if isSignedIn()
        && isPassenger()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.bookingId is string
        && request.resource.data.driverId is string;
    }

    // ─── Notifications ─────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ─── Drivers (read-only for passengers during driver search) ───────────

    match /drivers/{driverId} {
      // currentBookingId may only be set in the commit that accepts that booking, and only
      // cleared once that booking is completed or cancelled. Unchanged is always fine.
      function isValidCurrentBookingChange() {
        let before = resource.data.get('currentBookingId', null);
        let after = request.resource.data.get('currentBookingId', null);
        return before == after
          || (
            before == null
            && after is string
            && get(bookingPath(after)).data.status == 'pending'
            && getAfter(bookingPath(after)).data.status == 'accepted'
            && getAfter(bookingPath(after)).data.driverId == request.auth.uid
          )
          || (
            before != null
            && after == null
            && getAfter(bookingPath(before)).data.status in ['completed', 'cancelled']
          );
      }

      // A request holds the driver who proposed on it while the passenger may still answer
      // (an unexpired proposal), and once accepted while its booking (bookings/{requestId})
      // still waits for this driver's claim. Claiming moves the hold to currentBookingId; a
      // cancelled booking (or an accepted request without one) holds nobody. Requests
      // without expiresAt (created before expiry was required) hold until withdrawn.
      function requestHoldsDriver(id, data) {
        return data.driverId == request.auth.uid
          && (
            (
              data.status == 'accepted'
              && existsAfter(bookingPath(id))
              && getAfter(bookingPath(id)).data.status == 'pending'
            )
            || (
              data.status in ['driver_interested', 'negotiating']
              && (data.get('expiresAt', null) == null || request.time < data.expiresAt)
            )
          );
      }

      // currentRequestId may only be set in the commit that proposes a fare on that request
      // (searching → negotiating with this driver), and only cleared once the request no
      // longer holds this driver: withdrawn or declined (back to searching), cancelled,
      // expired (status or past expiresAt), rejected, taken by another driver, its booking
      // cancelled, or its booking claimed (in the claim commit).
      function isValidCurrentRequestChange() {
        let before = resource.data.get('currentRequestId', null);
        let after = request.resource.data.get('currentRequestId', null);
        return before == after
          || (
            before == null
            && after is string
            && get(requestPath(after)).data.status == 'searching'
            && getAfter(requestPath(after)).data.status == 'negotiating'
            && getAfter(requestPath(after)).data.driverId == request.auth.uid
          )
          || (
            before != null
            && after == null
            && !requestHoldsDriver(before, getAfter(requestPath(before)).data)
          );
      }

      allow read: if isSignedIn()
        && resource.data.isVerified == true;

      // A driver can always read their own record, including while pending verification.
      allow read: if isOwner(driverId);

      // Admins read every driver record, including revoked and unverified ones (Drivers page).
      allow read: if isAdmin();

      // Admin revokes or restores verification (Drivers page), recording who and when.
      // Revoking needs a reason (shown to admins) and takes the driver offline and
      // unavailable in the same write; the current trip link is untouched, so a driver
      // revoked mid-ride can still finish it (trip updates use isDriver()). Restoring
      // clears the reason and leaves the driver offline until they go online in the app.
      allow update: if isAdmin()
        && onlyChanged([
          'isVerified', 'isOnline', 'isAvailable',
          'verificationNote', 'verificationUpdatedAt', 'verificationUpdatedBy'
        ])
        && request.resource.data.verificationUpdatedAt == request.time
        && request.resource.data.verificationUpdatedBy == request.auth.uid
        && request.resource.data.isOnline == false
        && request.resource.data.isAvailable == false
        && (
          (
            resource.data.get('isVerified', false) == true
            && request.resource.data.isVerified == false
            && request.resource.data.verificationNote is string
            && request.resource.data.verificationNote.size() > 0
            && request.resource.data.verificationNote.size() <= 500
          )
          || (
            resource.data.get('isVerified', false) != true
            && request.resource.data.isVerified == true
            && request.resource.data.get('verificationNote', null) == null
          )
        );

      // A driver controls only their own duty status, position, current-trip link and
      // proposal reservation. Admin-managed fields (isVerified, name, vehicle, rating)
      // cannot be changed from the app. Being available requires being online, an
      // unverified driver can only be offline, and a driver linked to a booking or
      // reserved by a proposal is never available.
      allow update: if isOwner(driverId)
        && isDriver()
        && onlyChanged([
          'isOnline', 'isAvailable', 'currentLocation', 'currentBookingId', 'currentRequestId',
          'updatedAt'
        ])
        && request.resource.data.isOnline is bool
        && request.resource.data.isAvailable is bool
        && (!request.resource.data.isAvailable || request.resource.data.isOnline)
        && (
          (!request.resource.data.isOnline && !request.resource.data.isAvailable)
          || resource.data.isVerified == true
        )
        && (
          !('currentLocation' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            request.resource.data.currentLocation.latitude is number
            && request.resource.data.currentLocation.longitude is number
          )
        )
        && (
          request.resource.data.get('currentBookingId', null) == null
          || request.resource.data.isAvailable == false
        )
        && (
          request.resource.data.get('currentRequestId', null) == null
          || request.resource.data.isAvailable == false
        )
        && isValidCurrentBookingChange()
        && isValidCurrentRequestChange();

      // An admin creates the record only in the commit that approves this driver's
      // pending application (driver verification on the Admin Website), with exactly
      // these fields: name and plate from the application, a vehicle type the admin chose,
      // verified, offline, no trip, no rating yet. users/{uid}.role stays 'passenger'.
      allow create: if isAdmin()
        && exists(applicationPath(driverId))
        && get(applicationPath(driverId)).data.status == 'pending'
        && getAfter(applicationPath(driverId)).data.status == 'approved'
        && request.resource.data.keys().hasAll([
          'fullName', 'vehiclePlate', 'vehicleType', 'isVerified', 'isOnline', 'isAvailable',
          'currentLocation', 'currentBookingId', 'currentRequestId', 'rating', 'profileImage'
        ])
        && request.resource.data.keys().hasOnly([
          'fullName', 'vehiclePlate', 'vehicleType', 'isVerified', 'isOnline', 'isAvailable',
          'currentLocation', 'currentBookingId', 'currentRequestId', 'rating', 'profileImage'
        ])
        && request.resource.data.fullName == get(applicationPath(driverId)).data.fullName
        && request.resource.data.vehiclePlate == get(applicationPath(driverId)).data.vehiclePlate
        && request.resource.data.vehicleType in ['tricycle', 'motorcycle']
        && request.resource.data.isVerified == true
        && request.resource.data.isOnline == false
        && request.resource.data.isAvailable == false
        && request.resource.data.currentLocation == null
        && request.resource.data.currentBookingId == null
        && request.resource.data.currentRequestId == null
        && request.resource.data.rating == 0
        && request.resource.data.profileImage == null;

      allow delete: if false;
    }

    // ─── Driver applications ───────────────────────────────────────────────
    // One application per passenger at driverApplications/{uid}. Passengers can only
    // submit (always `pending`) or resubmit after a rejection. Approval, rejection,
    // adminRemarks and reviewedAt are set by admins only (Admin Website), so a passenger
    // can never approve themselves.

    match /driverApplications/{uid} {
      function isValidPersonName(name) {
        return name is string && name.size() >= 1 && name.size() <= 50;
      }

      // A document entry must reference this applicant's own file in Cloud Storage.
      function isValidApplicationDocument(entry, documentType) {
        return entry is map
          && entry.keys().hasAll(['storagePath', 'downloadUrl', 'fileName', 'contentType', 'uploadedAt'])
          && entry.keys().hasOnly(['storagePath', 'downloadUrl', 'fileName', 'contentType', 'uploadedAt'])
          && entry.storagePath == 'driverApplications/' + uid + '/' + documentType
          && entry.downloadUrl is string
          && entry.downloadUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*')
          && entry.fileName is string
          && entry.fileName.size() <= 200
          && entry.contentType is string
          && entry.contentType.matches('^image/.*')
          && (entry.uploadedAt == null || entry.uploadedAt is timestamp);
      }

      // Both required documents (OR/CR and LTO driver's license), nothing else.
      function hasValidDocuments(data) {
        return data.documents is map
          && data.documents.keys().hasAll(['orCr', 'ltoLicense'])
          && data.documents.keys().hasOnly(['orCr', 'ltoLicense'])
          && isValidApplicationDocument(data.documents.orCr, 'orCr')
          && isValidApplicationDocument(data.documents.ltoLicense, 'ltoLicense');
      }

      // Applicant details: structured name, the account's own email and mobile number.
      function hasValidApplicantDetails(data) {
        return isValidPersonName(data.firstName)
          && (data.middleName == null || isValidPersonName(data.middleName))
          && isValidPersonName(data.lastName)
          && data.fullName is string
          && data.fullName.size() <= 160
          && data.email == request.auth.token.email
          && data.mobileNumber == userDoc().data.mobileNumber
          && data.vehicleType in ['tricycle', 'motorcycle']
          && isValidVehiclePlate(data.vehiclePlate)
          && hasValidDocuments(data);
      }

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && isPassenger()
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'middleName', 'lastName', 'fullName', 'email', 'mobileNumber',
          'vehicleType', 'vehiclePlate', 'documents',
          'status', 'adminRemarks', 'submittedAt', 'updatedAt', 'reviewedAt'
        ])
        && request.resource.data.uid == uid
        && hasValidApplicantDetails(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.adminRemarks == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Controlled resubmission: only after an administrator rejected the application.
      // uid, adminRemarks and reviewedAt cannot change.
      allow update: if isOwner(uid)
        && isPassenger()
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'middleName', 'lastName', 'fullName', 'email', 'mobileNumber',
          'vehicleType', 'vehiclePlate', 'documents', 'status', 'submittedAt', 'updatedAt'
        ])
        && hasValidApplicantDetails(request.resource.data)
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Admin review of a pending application. Only status, adminRemarks, reviewedAt and
      // updatedAt change; applicant fields are never edited by the admin.
      function isAdminReview() {
        return isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'adminRemarks', 'reviewedAt', 'updatedAt'
          ])
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      function isValidRemarks(remarks) {
        return remarks is string && remarks.size() <= 500 && remarks.trim().size() > 0;
      }

      // Approve: remarks optional, and drivers/{uid} must be created in the same commit
      // (its create rule fixes the field set).
      allow update: if isAdminReview()
        && request.resource.data.status == 'approved'
        && (request.resource.data.adminRemarks == null
          || isValidRemarks(request.resource.data.adminRemarks))
        && !exists(driverPath(uid))
        && existsAfter(driverPath(uid));

      // Reject: remarks required (shown to the applicant), at most 500 characters.
      allow update: if isAdminReview()
        && request.resource.data.status == 'rejected'
        && isValidRemarks(request.resource.data.adminRemarks);

      allow delete: if false;
    }

    // ─── Fare settings ─────────────────────────────────────────────────────
    // fareSettings/active: { fares, outOfArea, updatedAt, updatedBy }. The app reads it
    // (falling back to in-code defaults when missing). Only admins write `fares`, always as
    // a complete object: both vehicle types, each with exactly baseFare and perKm.
    // `outOfArea` is written separately (System settings page), also only by admins and
    // always as a complete object; each write changes either `fares` or `outOfArea`.

    match /fareSettings/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /fareSettings/active {
      function isValidVehicleFare(fare) {
        return fare is map
          && fare.keys().hasAll(['baseFare', 'perKm'])
          && fare.keys().hasOnly(['baseFare', 'perKm'])
          && fare.baseFare is number
          && fare.baseFare >= 0
          && hasAtMostTwoDecimals(fare.baseFare)
          && fare.perKm is number
          && fare.perKm > 0
          && hasAtMostTwoDecimals(fare.perKm);
      }

      function isValidFares(fares) {
        return fares is map
          && fares.keys().hasAll(['tricycle', 'motorcycle'])
          && fares.keys().hasOnly(['tricycle', 'motorcycle'])
          && isValidVehicleFare(fares.tricycle)
          && isValidVehicleFare(fares.motorcycle);
      }

      function isValidFareWrite() {
        return isAdmin()
          && isValidFares(request.resource.data.fares)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
      }

      // Whole minutes and kilometres. The app also caps the expiry it writes at 30 minutes
      // (the outOfAreaRequests create rule allows up to 35 for clock skew).
      function isValidOutOfArea(value) {
        let keys = ['enabled', 'requestExpiryMinutes', 'driverSearchRadiusKm'];
        return value is map
          && value.keys().hasAll(keys)
          && value.keys().hasOnly(keys)
          && value.enabled is bool
          && value.requestExpiryMinutes is int
          && value.requestExpiryMinutes >= 1
          && value.requestExpiryMinutes <= 30
          && value.driverSearchRadiusKm is int
          && value.driverSearchRadiusKm >= 1
          && value.driverSearchRadiusKm <= 50;
      }

      function isValidOutOfAreaWrite() {
        return isAdmin()
          && isValidOutOfArea(request.resource.data.outOfArea)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
      }

      allow create: if (isValidFareWrite()
          && request.resource.data.keys().hasOnly(['fares', 'updatedAt', 'updatedBy']))
        || (isValidOutOfAreaWrite()
          && request.resource.data.keys().hasOnly(['outOfArea', 'updatedAt', 'updatedBy']));

      allow update: if (isValidFareWrite()
          && onlyChanged(['fares', 'updatedAt', 'updatedBy']))
        || (isValidOutOfAreaWrite()
          && onlyChanged(['outOfArea', 'updatedAt', 'updatedBy']));
    }

    // ─── Barangay tariffs ──────────────────────────────────────────────────
    // barangayTariffs/{barangayId}: the fixed per-trip tariff between Poblacion and one of
    // the 19 other barangays of Trinidad, per vehicle type. One document per barangay
    // (a single map of all 19 would exceed the rules expression limit to validate).
    // Only admins write, always the complete row. The mobile app does not apply tariffs
    // yet (needs barangay boundaries).

    match /barangayTariffs/{barangayId} {
      // Known IDs and their names. Keep in sync with admin/src/tariffs/barangays.ts.
      function barangayNames() {
        return {
          'banlasan': 'Banlasan',
          'bongbong': 'Bongbong',
          'catoogan': 'Catoogan',
          'guinobatan': 'Guinobatan',
          'hinlayagan-ilaud': 'Hinlayagan Ilaud',
          'hinlayagan-ilaya': 'Hinlayagan Ilaya',
          'kauswagan': 'Kauswagan',
          'kinan-oan': 'Kinan-oan',
          'la-union': 'La Union',
          'la-victoria': 'La Victoria',
          'mabuhay-cabigohan': 'Mabuhay Cabigohan',
          'mahagbu': 'Mahagbu',
          'manuel-m-roxas': 'Manuel M. Roxas',
          'san-isidro': 'San Isidro',
          'san-vicente': 'San Vicente',
          'santo-tomas': 'Santo Tomas',
          'soom': 'Soom',
          'tagum-norte': 'Tagum Norte',
          'tagum-sur': 'Tagum Sur'
        };
      }

      function isValidTariff(value) {
        return value is number && value > 0 && hasAtMostTwoDecimals(value);
      }

      function isValidTariffWrite() {
        let data = request.resource.data;
        let keys = ['name', 'tricycle', 'motorcycle', 'active', 'updatedAt', 'updatedBy'];
        return isAdmin()
          && barangayId in barangayNames()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.name == barangayNames()[barangayId]
          && isValidTariff(data.tricycle)
          && isValidTariff(data.motorcycle)
          && data.active is bool
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid;
      }

      allow read: if isSignedIn();
      allow create, update: if isValidTariffWrite();
      allow delete: if false;
    }

    // ─── Commission settings ───────────────────────────────────────────────
    // commissionSettings/active: { percentage, paymentPeriodDays, gracePeriodDays,
    // updatedAt, updatedBy }. Commission = percentage of the final fare (docs/DECISIONS.md).
    // Stored only for now: nothing charges drivers yet. Admin-only read and write, always
    // the complete object.

    match /commissionSettings/active {
      function isValidCommissionWrite() {
        let data = request.resource.data;
        let keys = ['percentage', 'paymentPeriodDays', 'gracePeriodDays', 'updatedAt', 'updatedBy'];
        return isAdmin()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.percentage is number
          && data.percentage > 0
          && data.percentage <= 100
          && hasAtMostTwoDecimals(data.percentage)
          && data.paymentPeriodDays is int
          && data.paymentPeriodDays >= 1
          && data.paymentPeriodDays <= 31
          && data.gracePeriodDays is int
          && data.gracePeriodDays >= 0
          && data.gracePeriodDays <= 14
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid;
      }

      allow read: if isAdmin();
      allow create, update: if isValidCommissionWrite();
      allow delete: if false;
    }

    // ─── Support contacts ──────────────────────────────────────────────────
    // supportContacts/{contactId}: { label, phone, active, sortOrder, updatedAt, updatedBy }.
    // Shown on the app's Help screen (active ones only, tap to call). Admins read, write
    // (always the complete document) and delete; signed-in users read active contacts.

    match /supportContacts/{contactId} {
      function isValidContactWrite() {
        let data = request.resource.data;
        let keys = ['label', 'phone', 'active', 'sortOrder', 'updatedAt', 'updatedBy'];
        return isAdmin()
          && data.keys().hasAll(keys)
          && data.keys().hasOnly(keys)
          && data.label is string
          && data.label.trim().size() > 0
          && data.label.size() <= 60
          && data.phone is string
          && data.phone.matches('[+]?[0-9 ()-]{6,19}[0-9]')
          && data.active is bool
          && data.sortOrder is int
          && data.sortOrder >= 0
          && data.sortOrder <= 99
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid;
      }

      allow read: if isAdmin() || (isSignedIn() && resource.data.active == true);
      allow create, update: if isValidContactWrite();
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
