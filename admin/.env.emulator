# Loaded only by `npm run dev:emulator` (vite --mode emulator); overrides .env.local.
# Points the admin website at the local Auth + Firestore emulators under a demo project.
# Not secrets: demo-* projects never reach real Firebase.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-trigo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-trigo
VITE_FIREBASE_STORAGE_BUCKET=demo-trigo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
